---
import VerificationBadge from './VerificationBadge.astro';
import { CATEGORY_LABELS, levelLabel, type Guia } from '../lib/guides';

interface Props {
  guia: Guia;
}
const { data } = Astro.props.guia;
const { verification } = data;
---

<li
  class="card"
  data-guide
  data-category={data.category}
  data-level-min={data.levelMin ?? ''}
  data-level-max={data.levelMax ?? ''}
>
  <article>
    <div class="card__tags">
      <VerificationBadge status={verification.status} />
      {data.example && <span class="tag tag--example">Ejemplo</span>}
    </div>
    <h2 class="card__title">
      <a href={`/guias/${data.slug}/`}>{data.title}</a>
    </h2>
    <p class="card__summary">{data.summary}</p>
    <p class="card__meta">
      <span>{CATEGORY_LABELS[data.category]}</span>
      <span aria-hidden="true">·</span>
      <span>{levelLabel(data)}</span>
      <span aria-hidden="true">·</span>
      <span>{data.steps.length} {data.steps.length === 1 ? 'paso' : 'pasos'}</span>
    </p>
  </article>
</li>

<style>
  .card {
    position: relative;
    list-style: none;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border, #4a3b2c);
    border-radius: 10px;
    background: var(--surface, #241b14);
  }
  .card:focus-within {
    outline: 3px solid var(--focus, #ffcf5a);
    outline-offset: 2px;
  }
  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }
  .card__title {
    margin: 0 0 0.35rem;
    font-size: 1.2rem;
  }
  .card__title a {
    color: inherit;
    text-decoration: none;
  }
  /* Toda la tarjeta es clicable, pero el enlace sigue siendo uno solo para lectores de pantalla. */
  .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .card__title a:focus {
    outline: none;
  }
  .card__summary {
    margin: 0 0 0.6rem;
  }
  .card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    font-size: 0.9rem;
    opacity: 0.85;
  }
  .tag--example {
    padding: 0.2em 0.6em;
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: #3b3f8f;
    color: #eef0ff;
  }
</style>

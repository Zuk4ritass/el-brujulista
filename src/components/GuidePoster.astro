---
// Tarjeta-póster de una guía: dibujo arriba, título abajo, como una carátula de caricatura.
// Si la guía no trae `cover`, el dibujo se genera según la categoría (sin assets del juego).
import { Image } from 'astro:assets';
import { CATEGORY_LABELS, STATUS_LABELS, levelLabel, type Guia } from '../lib/guides';
import { stepId } from '../lib/slugify';
import { posterSvg } from '../lib/poster-art';

interface Props {
  guia: Guia;
  /** Tamaño en filas (ancho fijo) o en cuadrícula. */
  size?: 'row' | 'grid';
  /** Primeras tarjetas visibles: cargar imagen sin lazy. */
  eager?: boolean;
}
const { guia, size = 'grid', eager = false } = Astro.props;
const { data } = guia;

const status = data.verification.status;
const stamp = { verificado: '✓ Probada', 'sin-verificar': 'Sin probar', desactualizado: '! Desactualizada' }[status];
const stepIds = data.steps.map(stepId).join(',');
const level = levelLabel(data);
const levelText = level.includes('POR COMPLETAR') ? null : level;
---

<li
  class:list={['poster', `poster--${size}`, `poster--${data.category}`]}
  data-poster
  data-slug={data.slug}
  data-category={data.category}
  data-level-min={data.levelMin ?? ''}
  data-level-max={data.levelMax ?? ''}
  data-step-ids={stepIds}
>
  <a href={`/guias/${data.slug}/`} class="poster__link">
    <div class="poster__art" aria-hidden="true">
      {
        data.cover ? (
          <Image src={data.cover} alt="" widths={[240, 400]} sizes="240px" loading={eager ? 'eager' : 'lazy'} />
        ) : (
          <Fragment set:html={posterSvg(data.category)} />
        )
      }
      <span class="poster__cat">{CATEGORY_LABELS[data.category]}</span>
      {data.example && <span class="poster__example">Ejemplo</span>}
    </div>

    <div class="poster__info">
      <h3 class="poster__title">{data.title}</h3>
      <p class="poster__meta">
        {levelText && <span>{levelText}</span>}
        <span>{data.steps.length} {data.steps.length === 1 ? 'paso' : 'pasos'}</span>
      </p>
      <span class:list={['poster__stamp', `poster__stamp--${status}`]} title={STATUS_LABELS[status]}>
        {stamp}
      </span>
    </div>

    <div class="poster__progress" data-poster-progress hidden>
      <span class="visually-hidden" data-poster-progress-text></span>
      <span class="poster__progress-bar" aria-hidden="true"><span data-poster-progress-fill></span></span>
    </div>
  </a>
</li>

<script>
  import { loadProgress } from '../lib/progress';

  // Barra de progreso en cada póster según lo guardado en este navegador.
  for (const poster of document.querySelectorAll<HTMLElement>('[data-poster]')) {
    const ids = (poster.dataset.stepIds ?? '').split(',').filter(Boolean);
    const saved = loadProgress(poster.dataset.slug ?? '');
    const done = ids.filter((id) => saved.has(id)).length;
    poster.dataset.done = String(done);
    poster.dataset.total = String(ids.length);
    if (done === 0) continue;
    const box = poster.querySelector<HTMLElement>('[data-poster-progress]')!;
    box.hidden = false;
    box.querySelector<HTMLElement>('[data-poster-progress-fill]')!.style.width = `${(done / ids.length) * 100}%`;
    box.querySelector<HTMLElement>('[data-poster-progress-text]')!.textContent =
      done === ids.length ? 'Completada' : `Progreso: ${done} de ${ids.length} pasos`;
  }
</script>

<style>
  .poster {
    list-style: none;
    flex: none;
  }
  .poster--row {
    width: clamp(150px, 40vw, 210px);
    scroll-snap-align: start;
  }
  .poster__link {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: var(--line);
    border-radius: var(--radius);
    background: var(--card);
    color: var(--ink);
    text-decoration: none;
    box-shadow: var(--pop);
    transition:
      transform 0.18s cubic-bezier(0.3, 1.5, 0.5, 1),
      box-shadow 0.18s ease;
  }
  /* Al pasar el mouse la tarjeta se "levanta" y se ladea un poquito, como una carta */
  .poster__link:hover,
  .poster__link:focus-visible {
    transform: translate(-3px, -3px) rotate(-1.5deg);
    box-shadow: 8px 8px 0 var(--ink);
  }
  .poster:nth-child(even) .poster__link:hover,
  .poster:nth-child(even) .poster__link:focus-visible {
    transform: translate(-3px, -3px) rotate(1.5deg);
  }
  .poster__link:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 4px;
  }

  .poster__art {
    position: relative;
    aspect-ratio: 1;
    border-bottom: var(--line);
    overflow: hidden;
  }
  .poster__art :global(svg),
  .poster__art :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .poster__art :global(.poster__glyph) {
    transform-origin: 100px 100px;
    transition: transform 0.3s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .poster__link:hover :global(.poster__glyph) {
    transform: scale(1.08) rotate(-4deg);
  }

  .poster__cat,
  .poster__example {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    padding: 0.05em 0.55em;
    border: 2px solid var(--ink);
    border-radius: 8px;
    background: var(--card);
    font: 400 0.85rem/1.4 var(--font-display);
  }
  .poster__example {
    left: auto;
    right: 0.5rem;
    background: var(--blue);
    color: #fff;
    rotate: 4deg;
  }

  .poster__info {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.25rem;
    padding: 0.65rem 0.75rem 0.75rem;
  }
  .poster__title {
    margin: 0;
    font-size: clamp(1.1rem, 3.4vw, 1.3rem);
    line-height: 1.1;
    overflow-wrap: anywhere;
  }
  .poster__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.6rem;
    margin: 0;
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--ink-soft);
  }
  /* Sello de estado escrito (sin íconos que haya que aprender) */
  .poster__stamp {
    align-self: flex-start;
    margin-top: auto;
    padding: 0.05em 0.5em;
    border: 2px solid currentColor;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .poster__stamp--verificado {
    color: var(--green-dark);
    background: #e6f4d2;
  }
  .poster__stamp--sin-verificar {
    color: var(--ink-soft);
    border-style: dashed;
  }
  .poster__stamp--desactualizado {
    color: #a3291f;
    background: #fbe1dc;
  }

  /* Barra de "ya empezaste" pegada abajo de la tarjeta */
  .poster__progress {
    position: absolute;
    inset: auto 0 0;
  }
  .poster__progress-bar {
    display: block;
    height: 7px;
    border-top: 2px solid var(--ink);
    background: var(--paper-2);
  }
  .poster__progress-bar > span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--green);
  }
</style>

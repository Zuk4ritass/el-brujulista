---
// Islita isométrica dibujada por nosotros (guiño a los mapas de rombos del 1.29, sin assets del juego).
// El SVG se arma al compilar; en el navegador solo se anima el aventurero caminando por el camino.
const N = 6; // casillas por lado
const W = 24; // media anchura de una casilla
const H = 12; // media altura de una casilla
const ox = 320;
const oy = 36;
const cell = (i: number, j: number) => [ox + (i - j) * W, oy + (i + j) * H + H] as const;
const diamond = (x: number, y: number) => `${x},${y - H} ${x + W},${y} ${x},${y + H} ${x - W},${y}`;
const has = (list: number[][], i: number, j: number) => list.some(([a, b]) => a === i && b === j);

const path = [[0, 2], [1, 2], [2, 2], [2, 3], [3, 3], [4, 3], [4, 4], [5, 4]];
const blue = [[1, 4], [0, 5]];
const red = [[4, 0], [5, 1]];

const tiles = [] as { points: string; fill: string }[];
for (let i = 0; i < N; i++)
  for (let j = 0; j < N; j++) {
    const [x, y] = cell(i, j);
    let fill = (i + j) % 2 ? '#9fd25a' : '#8cc63f';
    if (has(path, i, j)) fill = '#e8c98a';
    if (has(blue, i, j)) fill = '#7fb0ec';
    if (has(red, i, j)) fill = '#ef8a7f';
    tiles.push({ points: diamond(x, y), fill });
  }

// Bordes de la isla
const top = [cell(0, 0)[0], cell(0, 0)[1] - H];
const rt = [cell(N - 1, 0)[0] + W, cell(N - 1, 0)[1]];
const bt = [cell(N - 1, N - 1)[0], cell(N - 1, N - 1)[1] + H];
const lf = [cell(0, N - 1)[0] - W, cell(0, N - 1)[1]];
const D = 34; // grosor de la tierra
const sides = `${lf} ${bt} ${rt} ${rt[0]},${rt[1] + D} ${bt[0]},${bt[1] + D} ${lf[0]},${lf[1] + D}`;

const trees = [cell(0, 0), cell(5, 5)];
const rock = cell(1, 0);
const sign = cell(3, 1);
const pathPoints = path.map(([i, j]) => cell(i, j).join(','));
---

<svg class="diorama" viewBox="150 -20 340 250" aria-hidden="true" data-diorama data-path={pathPoints.join(' ')}>
  <g stroke="#2b1a0e" stroke-linejoin="round" stroke-linecap="round">
    <polygon points={sides} fill="#b07a3e" stroke-width="3"></polygon>
    <polyline points={`${lf} ${bt} ${rt}`} fill="none" stroke="#8a5a2b" stroke-width="2"></polyline>
    <path d={`M${bt[0]} ${bt[1] + D}l-10 18l-10-14`} fill="#b07a3e" stroke-width="3"></path>
    {tiles.map((t) => <polygon points={t.points} fill={t.fill} stroke-width="1.5" stroke-opacity=".5" />)}
    <polygon points={`${top} ${rt} ${bt} ${lf}`} fill="none" stroke-width="3"></polygon>

    <path d={`M${rock[0] - 14} ${rock[1] - 4}c4-14 24-14 28 0z`} fill="#a3a3a3" stroke-width="2.5"></path>
    <rect x={sign[0] - 2} y={sign[1] - 30} width="4" height="30" fill="#8a5a2b" stroke-width="2"></rect>
    <rect x={sign[0] - 22} y={sign[1] - 42} width="44" height="17" rx="3" fill="#fffaf0" stroke-width="2.5"></rect>
    <text x={sign[0]} y={sign[1] - 29.5} text-anchor="middle" font-size="11" font-family="Lilita One, sans-serif" fill="#2b1a0e" stroke="none">¡Vamos!</text>
    {
      trees.map(([x, y]) => (
        <g>
          <rect x={x - 4} y={y - 26} width="8" height="24" fill="#8a5a2b" stroke-width="2.5" />
          <circle cx={x} cy={y - 38} r="18" fill="#4e9a3a" stroke-width="3" />
          <circle cx={x - 6} cy={y - 44} r="5" fill="#6fbf4f" stroke="none" />
        </g>
      ))
    }

    <!-- Aventurero propio: bolita con sombrero y bufanda -->
    <g data-hero transform={`translate(${pathPoints[0].replace(',', ' ')})`}>
      <ellipse cx="0" cy="0" rx="11" ry="5" fill="#2b1a0e" fill-opacity=".25" stroke="none"></ellipse>
      <g data-hero-body>
        <ellipse cx="0" cy="-16" rx="12" ry="14" fill="#fffaf0" stroke-width="3"></ellipse>
        <circle cx="-4" cy="-18" r="2" fill="#2b1a0e" stroke="none"></circle>
        <circle cx="4" cy="-18" r="2" fill="#2b1a0e" stroke="none"></circle>
        <path d="M-14 -26h28M-9 -26c0-10 18-10 18 0" fill="#f08a3c" stroke-width="3"></path>
        <path d="M10 -10l9 -5" stroke="#e2574c" stroke-width="4"></path>
      </g>
    </g>
  </g>
</svg>

<style>
  .diorama {
    display: block;
    width: 100%;
    overflow: visible;
  }
</style>

<script>
  // El aventurero va y vuelve por el camino, saltando casilla por casilla.
  const svg = document.querySelector<SVGSVGElement>('[data-diorama]');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (svg && !still) {
    const points = (svg.dataset.path ?? '').split(' ').map((p) => p.split(',').map(Number));
    const hero = svg.querySelector<SVGGElement>('[data-hero]')!;
    const body = svg.querySelector<SVGGElement>('[data-hero-body]')!;
    let k = 0;
    let dir = 1;
    let timer = 0;
    const step = () => {
      k += dir;
      if (k === points.length - 1 || k === 0) dir *= -1;
      const [x, y] = points[k];
      hero.setAttribute('transform', `translate(${x} ${y})`);
      body.animate([{ transform: 'translateY(0)' }, { transform: 'translateY(-7px)' }, { transform: 'translateY(0)' }], {
        duration: 320,
      });
    };
    // Solo camina mientras la isla está a la vista (ahorra batería).
    new IntersectionObserver(([e]) => {
      clearInterval(timer);
      if (e.isIntersecting) timer = window.setInterval(step, 620);
    }).observe(svg);
  }
</script>

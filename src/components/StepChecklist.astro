---
// Checklist de pasos con progreso guardado en el navegador.
// El HTML funciona sin JS (se ven los pasos); el script añade guardado, barra, "continuar" y reinicio.
import GameText from './GameText.astro';
import { stepId } from '../lib/slugify';
import MiniMapa from './MiniMapa.astro';
import Capturas from './Capturas.astro';
import ItemList from './ItemList.astro';

interface Item {
  nombre: string;
  cantidad?: number;
  sprite?: string;
}
interface Step {
  id?: string;
  title: string;
  description: string;
  map?: string;
  coords?: string;
  reward?: string;
  notes?: string;
  capturas?: string[];
  objetos?: Item[];
  recompensas?: Item[];
  opciones?: Opcion[];
}
interface Opcion {
  title: string;
  description: string;
  map?: string;
  coords?: string;
  notes?: string;
  capturas?: string[];
  objetos?: Item[];
  recompensas?: Item[];
}
interface Props {
  slug: string;
  steps: Step[];
}
const { slug, steps } = Astro.props;
const total = steps.length;
// "-12, 25" se muestra como placa de juego "[-12, 25]"; cualquier otro texto (ej. POR COMPLETAR) queda igual.
const parseCoords = (c: string) => {
  const m = c.match(/^\s*\[?\s*(-?\d+)\s*,\s*(-?\d+)\s*\]?\s*$/);
  return m ? { x: Number(m[1]), y: Number(m[2]) } : null;
};
const fmtCoords = (c: string) => {
  const p = parseCoords(c);
  return p ? `[${p.x}, ${p.y}]` : c;
};
---

<guide-checklist data-slug={slug}>
  <section class="progress" aria-labelledby="progreso-titulo">
    <h2 id="progreso-titulo" class="visually-hidden">Tu progreso</h2>
    <div class="progress__row">
      <p class="progress__text" data-progress-text aria-live="polite">0 de {total} pasos</p>
      <a class="progress__continue" href="#" data-continue hidden>Continuar donde quedaste ↓</a>
    </div>
    <progress data-progress-bar max={total} value="0" aria-labelledby="progreso-titulo"></progress>
    <p class="progress__warn" data-storage-warning hidden>
      Tu navegador no permite guardar datos: el progreso se perderá al cerrar esta pestaña.
    </p>
    <noscript><p class="progress__warn">Activa JavaScript para guardar tu progreso.</p></noscript>
  </section>

  <!-- Requisitos, contexto, etc. van aquí: debajo de la barra y antes de los pasos. -->
  <slot />

  <h2 class="visually-hidden">Pasos</h2>
  <ol class="steps">
    {
      steps.map((step, i) => {
        const id = stepId(step);
        const domId = `paso-${id}`;
        // Con coordenada válida, el mini mapa ya muestra coordenada y región: no se repiten en los chips.
        const pos = step.coords ? parseCoords(step.coords) : null;
        const showMap = !pos && step.map;
        const showCoords = !pos && step.coords;
        return (
          <li class="step" id={domId} data-step={id}>
            <div class="step__head">
              <input type="checkbox" id={`chk-${id}`} class="step__check" aria-describedby={`${domId}-desc`} />
              <label for={`chk-${id}`} class="step__title">
                <span class="step__num">{i + 1}.</span> <GameText text={step.title} />
              </label>
            </div>
            <div class="step__body">
              <p id={`${domId}-desc`}>
                <GameText text={step.description} />
              </p>
              {(showMap || showCoords || step.reward) && (
                <dl class="step__facts">
                  {showMap && step.map && (
                    <div>
                      <dt>Mapa</dt>
                      <dd><GameText text={step.map} /></dd>
                    </div>
                  )}
                  {showCoords && step.coords && (
                    <div class="step__coords">
                      <dt class="visually-hidden">Coordenadas</dt>
                      <dd><GameText text={fmtCoords(step.coords)} /></dd>
                    </div>
                  )}
                  {step.reward && (
                    <div>
                      <dt>Recompensa</dt>
                      <dd><GameText text={step.reward} /></dd>
                    </div>
                  )}
                </dl>
              )}
              {step.opciones && (
                <div class="opciones" role="list" aria-label="Elige uno de estos caminos">
                  {step.opciones.map((op, k) => {
                    const opPos = op.coords ? parseCoords(op.coords) : null;
                    return (
                      <>
                        <section class="opcion" role="listitem" aria-labelledby={`${domId}-op${k}`}>
                          <h3 class="opcion__title" id={`${domId}-op${k}`}>
                            <span class="opcion__tag">Opción {String.fromCharCode(65 + k)}</span>
                            <GameText text={op.title} />
                          </h3>
                          <p>
                            <GameText text={op.description} />
                          </p>
                          {!opPos && op.coords && (
                            <p class="step__coords opcion__coords">
                              <GameText text={fmtCoords(op.coords)} />
                            </p>
                          )}
                          <ItemList label="Necesitas" items={op.objetos ?? []} />
                          <ItemList label="Ganas" items={op.recompensas ?? []} tone="reward" />
                          {(opPos || (op.capturas?.length ?? 0) > 0) && (
                            <div class="step__visual opcion__visual">
                              {opPos && <MiniMapa x={opPos.x} y={opPos.y} nombre={op.map} />}
                              <Capturas files={op.capturas ?? []} alt={op.title} />
                            </div>
                          )}
                          {op.notes && (
                            <p class="step__notes">
                              <span class="step__notes-tag">[Nota]</span> <GameText text={op.notes} />
                            </p>
                          )}
                        </section>
                      </>
                    );
                  })}
                </div>
              )}
              <ItemList label="Necesitas" items={step.objetos ?? []} />
              <ItemList label="Ganas" items={step.recompensas ?? []} tone="reward" />
              {(pos || (step.capturas?.length ?? 0) > 0) && (
                <div class="step__visual">
                  {pos && <MiniMapa x={pos.x} y={pos.y} nombre={step.map} />}
                  <Capturas files={step.capturas ?? []} alt={step.title} />
                </div>
              )}
              {step.notes && (
                <p class="step__notes">
                  <span class="step__notes-tag">[Nota]</span> <GameText text={step.notes} />
                </p>
              )}
            </div>
          </li>
        );
      })
    }
  </ol>

  <!-- Visor de capturas ampliadas (uno solo para toda la guía) -->
  <dialog class="visor" data-visor aria-label="Captura ampliada">
    <img data-visor-img alt="Captura ampliada del paso" />
    <form method="dialog"><button class="btn btn--ghost visor__close">Cerrar ✕</button></form>
  </dialog>

  <div class="actions">
    <button type="button" class="btn btn--danger" data-reset>Reiniciar progreso de esta guía</button>
    <!-- Confirmación en la página (el confirm() nativo puede estar bloqueado y devolver false sin preguntar) -->
    <div class="reset-confirm" data-reset-confirm role="group" aria-labelledby="reset-q" hidden>
      <p id="reset-q" class="reset-confirm__q">¿Reiniciar? Se desmarcarán todos los pasos de esta guía.</p>
      <div class="reset-confirm__btns">
        <button type="button" class="btn btn--danger" data-reset-yes>Sí, reiniciar</button>
        <button type="button" class="btn btn--ghost" data-reset-no>Cancelar</button>
      </div>
    </div>
  </div>
</guide-checklist>

<style>
  guide-checklist {
    display: block;
  }

  /* Barra de progreso: fija arriba mientras se lee, para ver el avance de un vistazo. */
  .progress {
    position: sticky;
    top: 0;
    z-index: 5;
    margin-inline: calc(var(--gutter) * -1);
    padding: 0.6rem var(--gutter) 0.75rem;
    background: var(--paper);
    border-bottom: 2px dashed var(--rule);
  }
  .progress__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }
  .progress__text {
    margin: 0;
    font: 400 1.15rem/1.2 var(--font-display);
  }
  progress {
    display: block;
    width: 100%;
    height: 18px;
    margin-top: 0.45rem;
    appearance: none;
    border: var(--line);
    border-radius: 999px;
    background: var(--card);
    overflow: hidden;
  }
  progress::-webkit-progress-bar {
    background: var(--card);
  }
  progress::-webkit-progress-value {
    background: var(--blue);
    transition: width 0.35s cubic-bezier(0.3, 1.4, 0.5, 1);
  }
  progress::-moz-progress-bar {
    background: var(--blue);
  }
  .progress__warn {
    margin: 0.5rem 0 0;
    font-size: 0.9rem;
    color: var(--danger);
  }

  .steps {
    display: grid;
    gap: 1rem;
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .step {
    padding: 1rem 1.1rem;
    border: var(--line);
    border-radius: var(--radius);
    background: var(--card);
    box-shadow: var(--pop);
    scroll-margin-top: 6rem;
    transition:
      opacity 0.25s ease,
      box-shadow 0.25s ease,
      background 0.25s ease;
  }
  .step__head {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
  }

  /* Checkbox en forma de rombo, como una casilla de combate.
     Sigue siendo un input nativo: teclado y lectores de pantalla funcionan igual. */
  .step__check {
    flex: none;
    display: grid;
    place-content: center;
    width: 1.75rem;
    height: 1.75rem;
    margin: 0.2rem 0.15rem 0;
    appearance: none;
    border: var(--line);
    border-radius: 5px;
    background: var(--card);
    rotate: 45deg;
    cursor: pointer;
    transition: background 0.2s ease, scale 0.2s cubic-bezier(0.3, 1.8, 0.5, 1);
  }
  .step__check:hover {
    background: var(--soft-blue);
  }
  /* El check se dibuja "derecho" compensando el giro del rombo */
  .step__check::after {
    content: '';
    width: 0.5rem;
    height: 0.9rem;
    margin-top: -0.15rem;
    border: solid var(--ink);
    border-width: 0 4px 4px 0;
    transform: scale(0);
    transition: transform 0.2s cubic-bezier(0.3, 1.8, 0.5, 1);
  }
  .step__check:checked {
    background: var(--green);
    color: var(--on-accent);
    scale: 1.08;
  }
  .step__check:checked::after {
    transform: scale(1);
    border-color: var(--on-accent);
  }
  .step__title {
    font: 400 1.3rem/1.25 var(--font-display);
    cursor: pointer;
    padding-top: 0.1rem;
  }
  .step__num {
    color: var(--orange);
  }
  .step__body {
    padding-left: 2.85rem;
  }
  .step__body p {
    margin: 0.5rem 0 0;
  }
  /* Mapa / coordenadas / recompensa en una sola línea de chips */
  .step__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.6rem 0 0;
  }
  .step__facts > div {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    padding: 0.15rem 0.6rem;
    border: 2px solid var(--ink);
    border-radius: 8px;
    background: var(--paper);
  }
  .step__facts dt {
    font-size: 0.72rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
  }
  .step__facts dd {
    margin: 0;
    font-weight: 800;
  }
  /* Coordenadas en placa oscura, como el indicador del mapa en el juego */
  .step__facts > .step__coords {
    border-color: var(--ink);
    background: var(--plaque);
    color: var(--yellow);
    font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace;
  }
  /* Mini mapa y capturas lado a lado cuando hay espacio */
  .step__visual {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0 1rem;
  }
  /* Mini mapa (para ubicarse) y captura (para reconocer el lugar) lado a lado; en móvil, uno debajo del otro */
  .step__visual > :global(*) {
    flex: 1 1 240px;
    max-width: 340px;
  }
  .step__visual :global(.capturas) {
    margin-top: 0.75rem;
  }

  .visor {
    max-width: min(96vw, 1200px);
    padding: 0.6rem;
    border: var(--line);
    border-radius: 14px;
    background: var(--card);
    box-shadow: var(--pop-lg);
  }
  .visor::backdrop {
    background: rgb(43 26 14 / 0.75);
  }
  .visor img {
    display: block;
    max-width: 100%;
    max-height: 78vh;
    border-radius: 8px;
  }
  .visor form {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.6rem;
  }

  /* Nota como burbuja de chat */
  .step__notes {
    position: relative;
    display: inline-block;
    max-width: 100%;
    margin-top: 0.75rem !important;
    padding: 0.35rem 0.8rem;
    border: 2px solid var(--ink);
    border-radius: 12px;
    background: var(--bubble);
    font-size: 0.95rem;
  }
  .step__notes::after {
    content: '';
    position: absolute;
    left: 14px;
    bottom: -8px;
    width: 12px;
    height: 12px;
    border: solid var(--ink);
    border-width: 0 2px 2px 0;
    background: var(--bubble);
    rotate: 45deg;
  }
  .step__notes-tag {
    font-weight: 900;
    color: var(--blue);
  }

  /* Paso completado: se pliega a solo el título, tachado y sin sombra. */
  .step.is-done {
    padding-block: 0.6rem;
    opacity: 0.65;
    background: var(--paper);
    box-shadow: none;
  }
  .step.is-done .step__title {
    text-decoration: line-through;
    text-decoration-thickness: 3px;
  }
  .step.is-done .step__body {
    display: none;
  }
  /* Siguiente paso pendiente: resaltado para retomar rápido. */
  .step.is-next {
    background: var(--soft-yellow-2);
    box-shadow: var(--pop-lg);
  }
  .step.is-next .step__title::after {
    content: '¡Sigue este!';
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.05em 0.5em;
    border: 2px solid var(--ink);
    border-radius: 6px;
    background: var(--yellow);
    color: var(--on-accent);
    font: 400 0.85rem/1.4 var(--font-display);
    vertical-align: 0.2em;
    rotate: -3deg;
  }

  /* Caminos alternativos de un paso: tarjetas una encima de la otra */
  .opciones {
    display: grid;
    gap: 0.85rem;
    margin-top: 0.85rem;
  }
  .opcion {
    min-width: 0;
    padding: 0.85rem 1rem;
    border: 2px dashed var(--ink);
    border-radius: 12px;
    background: var(--paper);
  }
  .opcion > p {
    margin: 0.35rem 0 0;
  }
  .opcion__title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    font-size: 1.1rem;
  }
  .opcion__tag {
    padding: 0.05em 0.5em;
    border: 2px solid var(--ink);
    border-radius: 6px;
    background: var(--teal);
    color: var(--on-accent);
    font-size: 0.8rem;
  }
  .actions {
    margin-top: 1.5rem;
  }
  .reset-confirm {
    display: grid;
    gap: 0.75rem;
    max-width: 34rem;
    padding: 1rem 1.1rem;
    border: var(--line);
    border-radius: var(--radius);
    background: var(--soft-red);
    box-shadow: var(--pop);
  }
  .reset-confirm__q {
    margin: 0;
    font-weight: 800;
  }
  .reset-confirm__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .step,
    progress::-webkit-progress-value {
      transition: none;
    }
  }
</style>

<script>
  import { isPersistent, loadProgress, saveProgress, resetProgress, progressKey } from '../lib/progress';

  class GuideChecklist extends HTMLElement {
    private slug = '';
    private done = new Set<string>();
    private steps: HTMLLIElement[] = [];

    connectedCallback() {
      this.slug = this.dataset.slug ?? '';
      this.steps = [...this.querySelectorAll<HTMLLIElement>('[data-step]')];
      // Ignora ids guardados de pasos que ya no existen (si la guía cambió).
      const valid = new Set(this.steps.map((s) => s.dataset.step!));
      this.done = new Set([...loadProgress(this.slug)].filter((id) => valid.has(id)));

      this.querySelector<HTMLElement>('[data-storage-warning]')!.hidden = isPersistent;

      for (const step of this.steps) {
        const chk = step.querySelector<HTMLInputElement>('input[type="checkbox"]')!;
        chk.addEventListener('change', () => {
          const id = step.dataset.step!;
          if (chk.checked) this.done.add(id);
          else this.done.delete(id);
          saveProgress(this.slug, this.done);
          this.render();
        });
      }

      // Reiniciar: el botón abre una confirmación en la página; "Sí" borra, "Cancelar" o Escape la cierran.
      const resetBtn = this.querySelector<HTMLButtonElement>('[data-reset]')!;
      const confirmBox = this.querySelector<HTMLElement>('[data-reset-confirm]')!;
      const yesBtn = this.querySelector<HTMLButtonElement>('[data-reset-yes]')!;
      const closeConfirm = (refocus: boolean) => {
        confirmBox.hidden = true;
        resetBtn.hidden = false;
        if (refocus) resetBtn.focus();
      };
      resetBtn.addEventListener('click', () => {
        resetBtn.hidden = true;
        confirmBox.hidden = false;
        yesBtn.focus();
      });
      this.querySelector('[data-reset-no]')!.addEventListener('click', () => closeConfirm(true));
      confirmBox.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeConfirm(true);
      });
      yesBtn.addEventListener('click', () => {
        this.done.clear();
        resetProgress(this.slug);
        closeConfirm(false);
        this.render();
        const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.steps[0]?.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'center' });
        this.steps[0]?.querySelector('input')?.focus({ preventScroll: true });
      });

      this.querySelector('[data-continue]')!.addEventListener('click', (e) => {
        e.preventDefault();
        const next = this.steps.find((s) => !this.done.has(s.dataset.step!));
        if (!next) return;
        const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
        next.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' });
        next.querySelector('input')?.focus({ preventScroll: true });
      });

      // Sincroniza si la misma guía está abierta en otra pestaña.
      window.addEventListener('storage', (e) => {
        if (e.key !== progressKey(this.slug)) return;
        this.done = new Set([...loadProgress(this.slug)].filter((id) => valid.has(id)));
        this.render();
      });

      // Capturas: clic en la miniatura abre el visor; clic fuera de la imagen lo cierra.
      const visor = this.querySelector<HTMLDialogElement>('[data-visor]')!;
      const visorImg = this.querySelector<HTMLImageElement>('[data-visor-img]')!;
      this.querySelectorAll<HTMLButtonElement>('[data-captura]').forEach((btn) =>
        btn.addEventListener('click', () => {
          visorImg.src = btn.dataset.captura!;
          visor.showModal();
        }),
      );
      visor.addEventListener('click', (e) => {
        if (e.target === visor) visor.close();
      });

      this.render();
    }

    private render() {
      const total = this.steps.length;
      const count = this.done.size;
      const next = this.steps.find((s) => !this.done.has(s.dataset.step!));

      for (const step of this.steps) {
        const isDone = this.done.has(step.dataset.step!);
        step.querySelector<HTMLInputElement>('input')!.checked = isDone;
        step.classList.toggle('is-done', isDone);
        step.classList.toggle('is-next', step === next && count > 0);
      }

      this.querySelector<HTMLProgressElement>('[data-progress-bar]')!.value = count;
      this.querySelector<HTMLElement>('[data-progress-text]')!.textContent =
        count === total ? `¡Guía completada! ${total} de ${total} pasos` : `${count} de ${total} pasos`;
      // "Continuar" solo tiene sentido si ya empezaste y no has terminado.
      this.querySelector<HTMLElement>('[data-continue]')!.hidden = !(count > 0 && count < total);
      this.querySelector<HTMLButtonElement>('[data-reset]')!.disabled = count === 0;
    }
  }

  customElements.define('guide-checklist', GuideChecklist);
</script>

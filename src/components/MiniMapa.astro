---
// Mini mapa compacto: el mapa real del juego alrededor de la coordenada, con la casilla marcada
// y botones para acercar/alejar (el zoom siempre queda centrado en la casilla del paso).
// Fondo: recorte del mapa del mundo (public/mapa/recortes/<x>_<y>.webp, lo genera `npm run mapa`).
// Si no hay recorte, se dibujan las zonas de src/data/zonas.ts (sin inventar geografía).
// Muestra la coordenada y el nombre de la región una sola vez, en la cabecera.
import { existsSync } from 'node:fs';
import { u } from '../lib/url';
import { join } from 'node:path';
import GameText from './GameText.astro';
import { ZONAS, type Terreno, type Zona } from '../data/zonas';
import cfg from '../data/mapa.json';

interface Props {
  x: number;
  y: number;
  /** Nombre de la región (el campo `map` del paso). Si falta, se usa la zona registrada. */
  nombre?: string;
}
const { x, y, nombre } = Astro.props;

const CW = cfg.casillaAncho;
const CH = cfg.casillaAlto;
const VX = cfg.ventanaX;
const VY = cfg.ventanaY;
const ASPECT = 0.5; // alto / ancho de la vista
const W = (VX * 2 + 1) * CW; // tamaño total del recorte
const H = (VY * 2 + 1) * CH;
const cx = (VX + 0.5) * CW; // centro de la casilla del paso
const cy = (VY + 0.5) * CH;
const zooms = cfg.zooms;
const box = (hx: number) => {
  const w = (hx * 2 + 1) * CW;
  const h = w * ASPECT;
  return `${cx - w / 2} ${cy - h / 2} ${w} ${h}`;
};

const FILL: Record<Terreno, string> = {
  pasto: '#a9d66a',
  bosque: '#6fae4b',
  arena: '#ecd28f',
  roca: '#b9ad9a',
  nieve: '#eef4fb',
  agua: '#8fc0ec',
  ciudad: '#d9c3a0',
  pantano: '#8fa86a',
};
const inside = (z: Zona, a: number, b: number) =>
  a >= Math.min(z.desde[0], z.hasta[0]) &&
  a <= Math.max(z.desde[0], z.hasta[0]) &&
  b >= Math.min(z.desde[1], z.hasta[1]) &&
  b <= Math.max(z.desde[1], z.hasta[1]);
// La última zona de la lista que contiene la casilla gana.
const zoneAt = (a: number, b: number) => [...ZONAS].reverse().find((z) => inside(z, a, b));
const region = nombre ?? zoneAt(x, y)?.nombre ?? 'Zona: POR COMPLETAR';

const recorte = `${x}_${y}.webp`;
const bg = existsSync(join(process.cwd(), 'public', 'mapa', 'recortes', recorte)) ? u(`/mapa/recortes/${recorte}`) : null;

// Sin fondo: casillas coloreadas según las zonas registradas.
const cells = bg
  ? []
  : Array.from({ length: (VX * 2 + 1) * (VY * 2 + 1) }, (_, i) => {
      const col = i % (VX * 2 + 1);
      const row = Math.floor(i / (VX * 2 + 1));
      const z = zoneAt(x - VX + col, y - VY + row);
      return { col, row, fill: z ? FILL[z.terreno] : '#f3e8cc' };
    });
// Cuadrícula en un solo trazo
let grid = '';
for (let c = 0; c <= VX * 2 + 1; c++) grid += `M${c * CW} 0V${H}`;
for (let r = 0; r <= VY * 2 + 1; r++) grid += `M0 ${r * CH}H${W}`;
---

<mini-mapa class="minimapa" data-zooms={JSON.stringify(zooms)} data-zoom={cfg.zoomInicial} data-cx={cx} data-cy={cy} data-cw={CW} data-aspect={ASPECT}>
  <p class="minimapa__head">
    <span class="minimapa__region"><GameText text={region} /></span>
    <span class="minimapa__coords">[{x}, {y}]</span>
  </p>
  <div class="minimapa__view">
    <svg viewBox={box(zooms[cfg.zoomInicial])} preserveAspectRatio="xMidYMid slice" role="img" aria-label={`Mapa alrededor de la coordenada ${x}, ${y}`} data-svg>
      <rect width={W} height={H} fill="#7f7f7f"></rect>
      {bg && <image href={bg} width={W} height={H} preserveAspectRatio="none" />}
      {cells.map((c) => <rect x={c.col * CW} y={c.row * CH} width={CW} height={CH} fill={c.fill} />)}
      <path d={grid} fill="none" stroke={bg ? '#fffaf0' : '#2b1a0e'} stroke-opacity={bg ? '.35' : '.2'} stroke-width="1" vector-effect="non-scaling-stroke"></path>
      <rect class="minimapa__here" x={VX * CW} y={VY * CH} width={CW} height={CH} fill="#ffd23f66" stroke="#ffd23f" stroke-width="3" vector-effect="non-scaling-stroke"></rect>
      <rect x={VX * CW} y={VY * CH} width={CW} height={CH} fill="none" stroke="#2b1a0e" stroke-width="1.5" vector-effect="non-scaling-stroke"></rect>
    </svg>
    <!-- Pin fuera del SVG: mantiene su tamaño en cualquier zoom (la casilla del paso siempre está al centro) -->
    <svg class="minimapa__pin" viewBox="-10 -26 20 27" aria-hidden="true">
      <path d="M0 0c-5-7-9-10-9-15a9 9 0 0 1 18 0c0 5-4 8-9 15z" fill="#e2574c" stroke="#2b1a0e" stroke-width="2" stroke-linejoin="round"></path>
      <circle cy="-15" r="3.2" fill="#fffaf0" stroke="#2b1a0e" stroke-width="1.5"></circle>
    </svg>
    <div class="minimapa__zoom" data-controls hidden>
      <button type="button" data-in aria-label="Acercar el mapa">+</button>
      <button type="button" data-out aria-label="Alejar el mapa">−</button>
    </div>
  </div>
</mini-mapa>

<style>
  .minimapa {
    display: block;
    max-width: 320px;
    margin: 0.75rem 0 0;
    padding: 0.45rem;
    border: var(--line);
    border-radius: 12px;
    background: var(--card);
    box-shadow: 3px 3px 0 var(--shadow);
  }
  /* Región a la izquierda (lo principal), coordenada pequeña a la derecha */
  .minimapa__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0 0.1rem 0.4rem !important;
    font-weight: 800;
    line-height: 1.25;
  }
  .minimapa__region {
    min-width: 0;
    font-size: 0.88rem;
  }
  .minimapa__coords {
    flex: none;
    padding: 0 0.35rem;
    border-radius: 5px;
    background: var(--plaque);
    color: var(--yellow);
    font-family: ui-monospace, 'Cascadia Mono', Consolas, monospace;
    font-size: 0.78rem;
  }
  .minimapa__view {
    position: relative;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    border: 2px solid var(--ink);
    border-radius: 8px;
    background: #7f7f7f;
  }
  .minimapa__view > svg[data-svg] {
    display: block;
    width: 100%;
    height: 100%;
  }
  .minimapa__here {
    animation: pulse 1.6s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      fill-opacity: 0.15;
    }
  }
  .minimapa__pin {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 22px;
    translate: -50% -100%;
    margin-top: 2px;
    filter: drop-shadow(0 2px 0 var(--rule));
    pointer-events: none;
  }
  .minimapa__zoom {
    position: absolute;
    right: 0.35rem;
    bottom: 0.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .minimapa__zoom button {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 2px solid var(--ink);
    border-radius: 7px;
    background: var(--card);
    color: var(--ink);
    font: 400 1.15rem/1 var(--font-display);
    box-shadow: 2px 2px 0 var(--shadow);
    cursor: pointer;
  }
  .minimapa__zoom button:hover:not(:disabled) {
    background: var(--yellow);
  color: var(--on-accent);
  }
  .minimapa__zoom button:disabled {
    opacity: 0.4;
    cursor: default;
    box-shadow: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .minimapa__here {
      animation: none;
    }
  }
</style>

<script>
  // Acercar/alejar: cambia la vista del SVG con una animación corta, siempre centrada en la casilla del paso.
  class MiniMapa extends HTMLElement {
    connectedCallback() {
      const svg = this.querySelector<SVGSVGElement>('[data-svg]')!;
      const btnIn = this.querySelector<HTMLButtonElement>('[data-in]')!;
      const btnOut = this.querySelector<HTMLButtonElement>('[data-out]')!;
      const zooms: number[] = JSON.parse(this.dataset.zooms!);
      const cx = Number(this.dataset.cx), cy = Number(this.dataset.cy);
      const cw = Number(this.dataset.cw), aspect = Number(this.dataset.aspect);
      let level = Number(this.dataset.zoom);
      let current = (zooms[level] * 2 + 1) * cw;
      let raf = 0;

      const apply = (w: number) => {
        const h = w * aspect;
        svg.setAttribute('viewBox', `${cx - w / 2} ${cy - h / 2} ${w} ${h}`);
      };
      const go = (next: number) => {
        level = Math.max(0, Math.min(zooms.length - 1, next));
        btnIn.disabled = level === 0;
        btnOut.disabled = level === zooms.length - 1;
        const from = current, to = (zooms[level] * 2 + 1) * cw;
        cancelAnimationFrame(raf);
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
          current = to;
          return apply(to);
        }
        const t0 = performance.now();
        const step = (t: number) => {
          const k = Math.min(1, (t - t0) / 220);
          current = from + (to - from) * (1 - (1 - k) ** 3);
          apply(current);
          if (k < 1) raf = requestAnimationFrame(step);
        };
        raf = requestAnimationFrame(step);
      };

      btnIn.addEventListener('click', () => go(level - 1));
      btnOut.addEventListener('click', () => go(level + 1));
      this.querySelector<HTMLElement>('[data-controls]')!.hidden = false;
      go(level);
    }
  }
  customElements.define('mini-mapa', MiniMapa);
</script>

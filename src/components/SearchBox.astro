---
// Caja de búsqueda + datos del índice. Sin JS funciona como formulario normal hacia /guias/?q=...
import { getCollection } from 'astro:content';
import type { SearchDoc } from '../lib/search';

interface Props {
  id?: string;
  size?: 'big' | 'normal';
  placeholder?: string;
}
const { id = 'buscar', size = 'normal', placeholder = 'Busca una guía, un mapa, un monstruo…' } = Astro.props;

const guias = await getCollection('guias');
// "POR COMPLETAR" es relleno, no contenido: que no aparezca como resultado al buscar "completar".
const clean = (s: string) => s.replaceAll('POR COMPLETAR', ' ');
const docs: SearchDoc[] = guias.map((g) => ({
  slug: g.data.slug,
  title: clean(g.data.title),
  tags: clean(g.data.tags.join(' ')),
  summary: clean(g.data.summary),
  content: clean([
    ...g.data.requirements,
    ...g.data.steps.flatMap((s) => [s.title, s.description, s.map, s.reward, s.notes]),
    ...g.data.knownBugs.flatMap((b) => [b.description, b.workaround]),
    g.body ?? '',
  ]
    .filter((x): x is string => Boolean(x))
    .join(' ')),
}));
---

<form class:list={['search', `search--${size}`]} action="/guias/" method="get" role="search" data-search-form>
  <label for={id} class="visually-hidden">Buscar guías</label>
  <svg class="search__icon" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.6"></circle>
    <path d="M15.5 15.5L21 21" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"></path>
  </svg>
  <input
    id={id}
    name="q"
    type="search"
    placeholder={placeholder}
    autocomplete="off"
    spellcheck="false"
    enterkeyhint="search"
    data-search-input
  />
  <button type="button" class="search__clear" aria-label="Borrar búsqueda" data-search-clear hidden>✕</button>
</form>
<script type="application/json" data-search-docs set:html={JSON.stringify(docs)} />

<style>
  .search {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }
  .search__icon {
    position: absolute;
    left: 1rem;
    width: 1.3rem;
    height: 1.3rem;
    color: var(--text-soft);
    pointer-events: none;
  }
  input {
    width: 100%;
    min-height: 52px;
    padding: 0.7rem 3rem 0.7rem 3rem;
    border: 2px solid var(--border-strong);
    border-radius: 999px;
    background: rgb(14 10 6 / 0.85);
    color: var(--text);
    font: 600 1.05rem/1.2 var(--font-body);
    box-shadow: inset 0 2px 6px rgb(0 0 0 / 0.5), 0 8px 24px rgb(0 0 0 / 0.35);
    -webkit-appearance: none;
    appearance: none;
  }
  input::placeholder {
    color: #a8977a;
  }
  input::-webkit-search-cancel-button {
    display: none;
  }
  input:focus {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 0 4px rgb(242 193 78 / 0.25), 0 8px 24px rgb(0 0 0 / 0.35);
  }
  .search--big input {
    min-height: 60px;
    font-size: 1.15rem;
  }
  .search__clear {
    position: absolute;
    right: 0.6rem;
    width: 2.4rem;
    height: 2.4rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--text-soft);
    font-size: 1rem;
    cursor: pointer;
  }
  .search__clear:hover {
    background: rgb(255 255 255 / 0.08);
    color: var(--text);
  }
</style>

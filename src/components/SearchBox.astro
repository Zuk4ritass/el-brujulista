---
// Caja de búsqueda + datos del índice. Sin JS funciona como formulario normal hacia /guias/?q=...
import { getCollection } from 'astro:content';
import type { SearchDoc } from '../lib/search';
import { CATEGORY_LABELS, levelLabel } from '../lib/guides';

interface Props {
  id?: string;
  size?: 'big' | 'normal';
  placeholder?: string;
  /** Muestra sugerencias en un desplegable; elegir una lleva directo a la guía. */
  suggest?: boolean;
}
const {
  id = 'buscar',
  size = 'normal',
  placeholder = 'Busca una guía, un mapa, un monstruo…',
  suggest = false,
} = Astro.props;
const listId = `${id}-sugerencias`;

const guias = await getCollection('guias');
// "POR COMPLETAR" es relleno, no contenido: que no aparezca como resultado al buscar "completar".
const clean = (s: string) => s.replaceAll('POR COMPLETAR', ' ');
const docs: SearchDoc[] = guias.map((g) => ({
  slug: g.data.slug,
  title: clean(g.data.title),
  tags: clean(g.data.tags.join(' ')),
  summary: clean(g.data.summary),
  content: clean([
    ...g.data.requirements,
    ...g.data.steps.flatMap((s) => [s.title, s.description, s.map, s.reward, s.notes]),
    ...g.data.knownBugs.flatMap((b) => [b.description, b.workaround]),
    g.body ?? '',
  ]
    .filter((x): x is string => Boolean(x))
    .join(' ')),
  meta: {
    key: g.data.category,
    category: CATEGORY_LABELS[g.data.category],
    level: levelLabel(g.data).includes('POR COMPLETAR') ? '' : levelLabel(g.data),
    status: g.data.verification.status,
    example: g.data.example,
  },
}));
---

<form
  class:list={['search', `search--${size}`]}
  action="/guias/"
  method="get"
  role="search"
  data-search-form
  data-suggest={suggest ? '' : undefined}
>
  <label for={id} class="visually-hidden">Buscar guías</label>
  <svg class="search__icon" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.6"></circle>
    <path d="M15.5 15.5L21 21" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"></path>
  </svg>
  <input
    id={id}
    name="q"
    type="search"
    placeholder={placeholder}
    autocomplete="off"
    spellcheck="false"
    enterkeyhint="search"
    data-search-input
    role={suggest ? 'combobox' : undefined}
    aria-autocomplete={suggest ? 'list' : undefined}
    aria-expanded={suggest ? 'false' : undefined}
    aria-controls={suggest ? listId : undefined}
  />
  <button type="button" class="search__clear" aria-label="Borrar búsqueda" data-search-clear hidden>✕</button>
  {
    suggest && (
      <div class="suggest" data-suggest-panel hidden>
        <ul id={listId} role="listbox" aria-label="Sugerencias" data-suggest-list />
        <p class="suggest__empty" data-suggest-empty hidden>
          No hay guías con eso todavía. <a href="/sugerir/">Sugiere esta guía</a>
        </p>
        <a class="suggest__all" href="/guias/" data-suggest-all>Ver todo en el catálogo →</a>
      </div>
    )
  }
  <p class="visually-hidden" aria-live="polite" data-suggest-status></p>
</form>
<script type="application/json" data-search-docs set:html={JSON.stringify(docs)} />

<style>
  /* ---------- Desplegable de sugerencias ---------- */
  .suggest {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    z-index: 30;
    overflow: hidden;
    border: 2px solid var(--border-strong);
    border-radius: 16px;
    background: #1a120b;
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.6);
    text-align: left;
  }
  .suggest ul {
    margin: 0;
    padding: 0.35rem;
    list-style: none;
  }
  .suggest :global(.opt) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 0.65rem;
    border-radius: 10px;
    cursor: pointer;
  }
  .suggest :global(.opt[aria-selected='true']),
  .suggest :global(.opt:hover) {
    background: rgb(242 193 78 / 0.14);
  }
  .suggest :global(.opt[aria-selected='true']) {
    outline: 2px solid var(--gold);
    outline-offset: -2px;
  }
  .suggest :global(.opt__thumb) {
    position: relative;
    flex: none;
    width: 2.9rem;
    height: 4.3rem;
    overflow: hidden;
    border-radius: 6px;
    border: 1px solid rgb(255 255 255 / 0.18);
    box-shadow: 0 3px 8px rgb(0 0 0 / 0.5);
  }
  .suggest :global(.opt__thumb svg) {
    width: 100%;
    height: 100%;
    display: block;
  }
  .suggest :global(.opt__status) {
    position: absolute;
    top: 2px;
    right: 2px;
    display: grid;
    place-items: center;
    width: 1.05rem;
    height: 1.05rem;
    border-radius: 50%;
    font-size: 0.62rem;
    font-weight: 900;
  }
  .suggest :global(.opt__status--verificado) {
    background: #1f6b3a;
    border: 1.5px solid #f2fff5;
    color: #fff;
  }
  .suggest :global(.opt__status--sin-verificar) {
    background: rgb(0 0 0 / 0.65);
    border: 1.5px dashed var(--warn);
    color: var(--warn);
  }
  .suggest :global(.opt__status--desactualizado) {
    background: #5c1a1a;
    border: 1.5px solid var(--danger);
    color: #ffe3e0;
  }
  .suggest :global(.opt__text) {
    min-width: 0;
  }
  .suggest :global(.opt__title) {
    display: block;
    font: 600 1.05rem/1.2 var(--font-display);
    text-transform: uppercase;
    color: var(--text);
  }
  .suggest :global(.opt__title mark) {
    background: none;
    color: var(--gold);
  }
  .suggest :global(.opt__meta) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.5rem;
    margin-top: 0.3rem;
    font-size: 0.8rem;
    color: var(--text-soft);
  }
  .suggest :global(.opt__meta > span:not(:last-child)::after) {
    content: '·';
    margin-left: 0.5rem;
    opacity: 0.6;
  }
  .suggest :global(.opt__st) {
    font-weight: 700;
  }
  .suggest :global(.opt__st--verificado) {
    color: var(--ok);
  }
  .suggest :global(.opt__st--sin-verificar) {
    color: var(--warn);
  }
  .suggest :global(.opt__st--desactualizado) {
    color: var(--danger);
  }
  .suggest__empty {
    margin: 0;
    padding: 0.9rem 1rem 0.4rem;
    color: var(--text-soft);
  }
  .suggest__all {
    display: block;
    padding: 0.7rem 1rem;
    border-top: 1px solid var(--border);
    font-weight: 700;
    text-decoration: none;
  }
  .suggest__all:hover {
    background: rgb(255 255 255 / 0.05);
  }

  .search {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }
  .search__icon {
    position: absolute;
    left: 1rem;
    width: 1.3rem;
    height: 1.3rem;
    color: var(--text-soft);
    pointer-events: none;
  }
  input {
    width: 100%;
    min-height: 52px;
    padding: 0.7rem 3rem 0.7rem 3rem;
    border: 2px solid var(--border-strong);
    border-radius: 999px;
    background: rgb(14 10 6 / 0.85);
    color: var(--text);
    font: 600 1.05rem/1.2 var(--font-body);
    box-shadow: inset 0 2px 6px rgb(0 0 0 / 0.5), 0 8px 24px rgb(0 0 0 / 0.35);
    -webkit-appearance: none;
    appearance: none;
  }
  input::placeholder {
    color: #a8977a;
  }
  input::-webkit-search-cancel-button {
    display: none;
  }
  input:focus {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 0 4px rgb(242 193 78 / 0.25), 0 8px 24px rgb(0 0 0 / 0.35);
  }
  .search--big input {
    min-height: 60px;
    font-size: 1.15rem;
  }
  .search__clear {
    position: absolute;
    right: 0.6rem;
    width: 2.4rem;
    height: 2.4rem;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--text-soft);
    font-size: 1rem;
    cursor: pointer;
  }
  .search__clear:hover {
    background: rgb(255 255 255 / 0.08);
    color: var(--text);
  }
</style>

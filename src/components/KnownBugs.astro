---
import GameText from './GameText.astro';

interface Props {
  bugs: { description: string; workaround?: string }[];
}
const { bugs } = Astro.props;
---

<!-- Sin bugs conocidos, la sección no se muestra (menos ruido en la guía). -->
<section class="bugs" aria-labelledby="bugs-titulo" hidden={bugs.length === 0}>
  <h2 id="bugs-titulo"><span aria-hidden="true">⚠</span> Bugs conocidos</h2>
  {
    bugs.length === 0 ? null : (
      <ul>
        {bugs.map((b) => (
          <li class="bug">
            <p class="bug__desc">
              <span class="bug__label">Bug:</span> <GameText text={b.description} />
            </p>
            {b.workaround && (
              <p class="bug__fix">
                <span class="bug__label">Cómo evitarlo:</span> <GameText text={b.workaround} />
              </p>
            )}
          </li>
        ))}
      </ul>
    )
  }
</section>

<style>
  .bugs {
    margin-top: 2rem;
  }
  .bugs h2 {
    margin: 0 0 0.6rem;
    font-size: 1.4rem;
    color: var(--danger);
  }
  .bugs ul {
    display: grid;
    gap: 0.75rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .bug {
    padding: 0.8rem 1rem;
    border: var(--line);
    border-left: 8px solid var(--red);
    border-radius: 10px;
    background: var(--card);
  }
  .bug p {
    margin: 0;
  }
  .bug__fix {
    margin-top: 0.4rem !important;
  }
  .bug__label {
    font-weight: 700;
  }
</style>

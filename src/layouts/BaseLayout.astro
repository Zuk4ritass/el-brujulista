---
import '@fontsource-variable/oswald';
import '@fontsource-variable/nunito';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Guías paso a paso no oficiales para el servidor Trefus.' } = Astro.props;
const fullTitle = title === 'Inicio' ? 'Guías Trefus · Guías paso a paso' : `${title} · Guías Trefus`;

const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Inicio', match: (p: string) => p === '/' },
  { href: '/guias/', label: 'Guías', match: (p: string) => p.startsWith('/guias') },
  { href: '/sugerir/', label: 'Sugerir', match: (p: string) => p.startsWith('/sugerir') },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#140e09" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <!-- Marca que hay JS para activar animaciones de aparición; sin JS todo queda visible -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href="/">
          <img src="/favicon.svg" alt="" width="34" height="34" />
          <span>Guías <strong>Trefus</strong></span>
        </a>
        <nav aria-label="Principal">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.match(path) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            <li>
              <a class="nav-search" href="/guias/?buscar" aria-label="Buscar guías">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                  <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.6"></circle>
                  <path d="M15.5 15.5L21 21" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"></path>
                </svg>
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="contenido" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p class="site-footer__legal">
          <strong>Sitio de fans no oficial.</strong> No está afiliado, patrocinado ni aprobado por Ankama
          ni por el equipo de Trefus. Dofus es una marca registrada de Ankama. Aquí no se aloja ni se
          enlaza ningún cliente del juego.
        </p>
        <p class="site-footer__note">
          La información de las guías puede diferir de Dofus 2.x y puede quedar desactualizada. Revisa
          siempre el estado de verificación.
          <a href="/sugerir/">¿Falta una guía? Sugiérela</a>
        </p>
      </div>
    </footer>

    <script>
      // Animación de aparición al hacer scroll para elementos con .reveal
      const items = document.querySelectorAll<HTMLElement>('.reveal');
      if (!('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.1 },
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    z-index: 200;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    padding: 0.6rem 1rem;
    background: var(--surface);
    border: 2px solid var(--focus);
    border-radius: 8px;
  }
  main {
    flex: 1;
    outline: none;
  }

  .site-header {
    position: relative;
    z-index: 20;
    border-bottom: 3px solid #0b0704;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.05), transparent),
      repeating-linear-gradient(90deg, #2b1e13 0 120px, #2f2115 120px 240px);
    box-shadow: 0 4px 0 rgb(0 0 0 / 0.3);
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-block: 0.6rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text);
    text-decoration: none;
    font: 500 1.35rem/1 var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .brand strong {
    color: var(--gold);
    font-weight: 700;
  }
  nav ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: inline-block;
    padding: 0.55rem 0.85rem;
    border-radius: 8px;
    color: var(--text-soft);
    font: 500 1rem/1 var(--font-display);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }
  nav a:hover {
    color: var(--text);
    background: rgb(255 255 255 / 0.06);
  }
  .nav-search {
    display: inline-flex !important;
    align-items: center;
  }
  nav a[aria-current='page'] {
    color: #fff8ec;
    background: var(--orange);
    box-shadow: inset 0 -3px 0 var(--orange-dark);
  }

  .site-footer {
    margin-top: 4rem;
    padding-block: 2rem 2.5rem;
    border-top: 3px solid #0b0704;
    background: #0e0a06;
    color: var(--text-soft);
    font-size: 0.9rem;
  }
  .site-footer p {
    max-width: 70ch;
    margin: 0 0 0.6rem;
  }
  .site-footer__legal strong {
    color: var(--text);
  }
</style>

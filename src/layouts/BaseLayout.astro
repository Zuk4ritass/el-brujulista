---
import '@fontsource/lilita-one';
import { u, sinBase } from '../lib/url';
import '@fontsource-variable/nunito';
import '../styles/global.css';
import { SITE } from '../config';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Guías paso a paso no oficiales para el servidor Trefus.' } = Astro.props;
const fullTitle = title === 'Inicio' ? `${SITE.name} · ${SITE.tagline}, paso a paso` : `${title} · ${SITE.name}`;

const path = sinBase(Astro.url.pathname);
const nav = [
  { href: u('/guias/'), label: 'Guías', match: (p: string) => p.startsWith('/guias') },
  { href: u('/sugerir/'), label: 'Sugerir', match: (p: string) => p.startsWith('/sugerir') },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6ecd2" />
    <link rel="icon" type="image/svg+xml" href={u('/favicon.svg')} />
    <title>{fullTitle}</title>
    <!-- Tema antes de pintar (evita el destello claro): elección guardada o, si no hay, la del sistema -->
    <script is:inline>
      (() => {
        let t = null;
        try {
          t = localStorage.getItem('trefus:tema');
        } catch {}
        if (t !== 'dark' && t !== 'light') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', t === 'dark' ? '#1d150f' : '#f6ecd2');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href={u('/')} aria-label={`${SITE.name}, inicio`}>
          <img src={u('/favicon.svg')} alt="" width="40" height="40" />
          <span class="brand__text">
            <span class="brand__name">{SITE.name}</span>
            <span class="brand__tag">{SITE.tagline}</span>
          </span>
        </a>
        <nav aria-label="Principal">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.match(path) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="Cambiar a modo oscuro" title="Modo oscuro / claro">
          <!-- Luna (se ve en modo claro) -->
          <svg class="theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z" fill="var(--yellow)" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"></path>
          </svg>
          <!-- Sol (se ve en modo oscuro) -->
          <svg class="theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4.5" fill="var(--yellow)" stroke="currentColor" stroke-width="2.2"></circle>
            <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
          </svg>
        </button>
      </div>
    </header>

    <main id="contenido" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          <strong>{SITE.name} es un sitio de fans no oficial.</strong> No está afiliado, patrocinado ni aprobado por Ankama
          ni por el equipo de Trefus. Dofus es una marca registrada de Ankama. Aquí no se aloja ni se
          enlaza ningún cliente del juego.
        </p>
        <p class="site-footer__note">
          Las guías pueden diferir de Dofus 2.x. ¿Aún no ves lo que buscas? <a href={u('/sugerir/')}>Pídenos esa guía</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<script>
  // Botón ☀/🌙: alterna y guarda la elección; sin elección guardada, sigue los cambios del sistema.
  const KEY = 'trefus:tema';
  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const meta = document.querySelector('meta[name="theme-color"]');
  const set = (t: 'dark' | 'light') => {
    root.dataset.theme = t;
    meta?.setAttribute('content', t === 'dark' ? '#1d150f' : '#f6ecd2');
    if (btn) {
      btn.setAttribute('aria-label', t === 'dark' ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro');
      btn.setAttribute('aria-pressed', String(t === 'dark'));
    }
  };
  set(root.dataset.theme === 'dark' ? 'dark' : 'light');
  btn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    set(next);
    try {
      localStorage.setItem(KEY, next);
    } catch {}
  });
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
    let saved = null;
    try {
      saved = localStorage.getItem(KEY);
    } catch {}
    if (!saved) set(e.matches ? 'dark' : 'light');
  });
</script>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    z-index: 200;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    padding: 0.6rem 1rem;
    background: var(--card);
    border: var(--line);
    border-radius: 8px;
  }
  main {
    flex: 1;
    outline: none;
  }

  .site-header {
    position: relative;
    z-index: 20;
    border-bottom: var(--line);
    background: var(--card);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-block: 0.55rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
    text-decoration: none;
    font: 400 1.4rem/1 var(--font-display);
    white-space: nowrap;
  }
  .brand img {
    transition: transform 0.2s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .brand:hover img {
    transform: rotate(-20deg) scale(1.08);
  }
  .brand__text {
    display: grid;
  }
  .brand__tag {
    font: 800 0.72rem/1.2 var(--font-body);
    color: var(--ink-soft);
    letter-spacing: 0.02em;
  }
  nav ul {
    display: flex;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: inline-block;
    padding: 0.4rem 0.85rem;
    border: 2px solid transparent;
    border-radius: 10px;
    color: var(--ink);
    font: 400 1.1rem/1 var(--font-display);
    text-decoration: none;
  }
  nav a:hover {
    border-color: var(--ink);
  }
  nav {
    margin-left: auto;
  }
  /* Celular: que logo, menú y botón de tema quepan en una línea */
  @media (max-width: 480px) {
    .brand {
      font-size: 1.2rem;
    }
    .brand img {
      width: 34px;
      height: 34px;
    }
    .brand__tag {
      display: none;
    }
    nav ul {
      gap: 0.1rem;
    }
    nav a {
      padding: 0.4rem 0.55rem;
      font-size: 1rem;
    }
  }
  .theme-toggle {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.6rem;
    height: 2.6rem;
    padding: 0;
    border: 2px solid var(--ink);
    border-radius: 10px;
    background: var(--card);
    color: var(--ink);
    box-shadow: 2px 2px 0 var(--shadow);
    cursor: pointer;
    transition: transform 0.15s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .theme-toggle:hover {
    transform: rotate(-12deg);
  }
  .theme-toggle svg {
    width: 1.4rem;
    height: 1.4rem;
  }
  .theme-toggle__sun,
  :global([data-theme='dark']) .theme-toggle__moon {
    display: none;
  }
  :global([data-theme='dark']) .theme-toggle__sun {
    display: block;
  }
  nav a[aria-current='page'] {
    border-color: var(--ink);
    color: var(--on-accent);
    background: var(--yellow);
    color: var(--on-accent);
    box-shadow: 2px 2px 0 var(--shadow);
  }

  .site-footer {
    margin-top: 4rem;
    padding-block: 1.75rem 2.25rem;
    border-top: var(--line);
    background: var(--paper-2);
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .site-footer p {
    max-width: 70ch;
    margin: 0 0 0.5rem;
  }
  .site-footer strong {
    color: var(--ink);
  }
</style>

---
import '@fontsource/lilita-one';
import '@fontsource-variable/nunito';
import '../styles/global.css';
import { SITE } from '../config';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Guías paso a paso no oficiales para el servidor Trefus.' } = Astro.props;
const fullTitle = title === 'Inicio' ? `${SITE.name} · ${SITE.tagline}, paso a paso` : `${title} · ${SITE.name}`;

const path = Astro.url.pathname;
const nav = [
  { href: '/guias/', label: 'Guías', match: (p: string) => p.startsWith('/guias') },
  { href: '/sugerir/', label: 'Sugerir', match: (p: string) => p.startsWith('/sugerir') },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6ecd2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href="/" aria-label={`${SITE.name}, inicio`}>
          <img src="/favicon.svg" alt="" width="40" height="40" />
          <span class="brand__text">
            <span class="brand__name">{SITE.name}</span>
            <span class="brand__tag">{SITE.tagline}</span>
          </span>
        </a>
        <nav aria-label="Principal">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.match(path) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="contenido" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>
          <strong>{SITE.name} es un sitio de fans no oficial.</strong> No está afiliado, patrocinado ni aprobado por Ankama
          ni por el equipo de Trefus. Dofus es una marca registrada de Ankama. Aquí no se aloja ni se
          enlaza ningún cliente del juego.
        </p>
        <p class="site-footer__note">
          Las guías pueden diferir de Dofus 2.x. <a href="/sugerir/">¿Falta una guía? Sugiérela</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: -9999px;
    z-index: 200;
  }
  .skip:focus {
    left: 1rem;
    top: 1rem;
    padding: 0.6rem 1rem;
    background: var(--card);
    border: var(--line);
    border-radius: 8px;
  }
  main {
    flex: 1;
    outline: none;
  }

  .site-header {
    position: relative;
    z-index: 20;
    border-bottom: var(--line);
    background: var(--card);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-block: 0.55rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--ink);
    text-decoration: none;
    font: 400 1.4rem/1 var(--font-display);
    white-space: nowrap;
  }
  .brand img {
    transition: transform 0.2s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .brand:hover img {
    transform: rotate(-20deg) scale(1.08);
  }
  .brand__text {
    display: grid;
  }
  .brand__tag {
    font: 800 0.72rem/1.2 var(--font-body);
    color: var(--ink-soft);
    letter-spacing: 0.02em;
  }
  nav ul {
    display: flex;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: inline-block;
    padding: 0.4rem 0.85rem;
    border: 2px solid transparent;
    border-radius: 10px;
    color: var(--ink);
    font: 400 1.1rem/1 var(--font-display);
    text-decoration: none;
  }
  nav a:hover {
    border-color: var(--ink);
  }
  nav a[aria-current='page'] {
    border-color: var(--ink);
    background: var(--yellow);
    box-shadow: 2px 2px 0 var(--ink);
  }

  .site-footer {
    margin-top: 4rem;
    padding-block: 1.75rem 2.25rem;
    border-top: var(--line);
    background: var(--paper-2);
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .site-footer p {
    max-width: 70ch;
    margin: 0 0 0.5rem;
  }
  .site-footer strong {
    color: var(--ink);
  }
</style>

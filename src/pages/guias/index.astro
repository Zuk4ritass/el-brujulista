---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideCard from '../../components/GuideCard.astro';
import GuideFilters from '../../components/GuideFilters.astro';
import { sortGuides, type Category } from '../../lib/guides';

const guias = sortGuides(await getCollection('guias'));
// Solo ofrecemos en el filtro las categorías que tienen al menos una guía.
const categories = [...new Set(guias.map((g) => g.data.category))] as Category[];
---

<BaseLayout title="Guías" description="Listado de guías paso a paso para Trefus, filtrables por nivel y categoría.">
  <h1>Guías</h1>
  <p>
    Guías escritas para <strong>Trefus</strong>. Revisa el badge de cada una: solo las marcadas
    como <em>Verificado</em> se comprobaron jugando en el servidor.
  </p>

  <GuideFilters categories={categories} />
  <p class="count" id="conteo" role="status" aria-live="polite">{guias.length} guías</p>

  <ul class="grid" id="lista-guias">
    {guias.map((g) => <GuideCard guia={g} />)}
  </ul>
  <p class="empty" id="sin-resultados" hidden>
    No hay guías con esos filtros todavía. Prueba otro rango de nivel o categoría.
  </p>
</BaseLayout>

<style>
  .grid {
    display: grid;
    gap: 1rem;
    padding: 0;
    margin: 0.5rem 0 0;
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .count {
    margin: 0.5rem 0;
    font-size: 0.9rem;
    opacity: 0.85;
  }
  .empty {
    padding: 1rem;
    border: 1px dashed var(--border, #6b5640);
    border-radius: 10px;
  }
</style>

<script>
  import { LEVEL_RANGES } from '../../lib/guides';

  const form = document.querySelector<HTMLFormElement>('#filtros');
  const nivel = document.querySelector<HTMLSelectElement>('#f-nivel');
  const categoria = document.querySelector<HTMLSelectElement>('#f-categoria');
  const conteo = document.querySelector<HTMLElement>('#conteo');
  const vacio = document.querySelector<HTMLElement>('#sin-resultados');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-guide]')];

  if (form && nivel && categoria && conteo && vacio) {
    form.hidden = false;

    // Restaurar filtros desde la URL (?nivel=51-100&categoria=quest) para poder compartir el enlace.
    const params = new URLSearchParams(location.search);
    const setIfValid = (sel: HTMLSelectElement, v: string | null) => {
      if (v && [...sel.options].some((o) => o.value === v)) sel.value = v;
    };
    setIfValid(nivel, params.get('nivel'));
    setIfValid(categoria, params.get('categoria'));

    const apply = () => {
      const range = LEVEL_RANGES.find((r) => r.value === nivel.value);
      const cat = categoria.value;
      let visible = 0;

      for (const card of cards) {
        const min = card.dataset.levelMin ? Number(card.dataset.levelMin) : null;
        const max = card.dataset.levelMax ? Number(card.dataset.levelMax) : null;
        // Guías sin nivel conocido aparecen en cualquier rango (no las escondemos por falta de datos).
        const lvlOk = !range || ((min ?? 1) <= range.max && (max ?? 200) >= range.min);
        const catOk = !cat || card.dataset.category === cat;
        const show = lvlOk && catOk;
        card.hidden = !show;
        if (show) visible++;
      }

      conteo.textContent =
        visible === cards.length ? `${cards.length} guías` : `Mostrando ${visible} de ${cards.length} guías`;
      vacio.hidden = visible > 0;

      const next = new URLSearchParams();
      if (nivel.value) next.set('nivel', nivel.value);
      if (cat) next.set('categoria', cat);
      const qs = next.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    };

    form.addEventListener('change', apply);
    // `reset` se dispara antes de que los selects vuelvan a su valor inicial.
    form.addEventListener('reset', () => setTimeout(apply));
    form.addEventListener('submit', (e) => e.preventDefault());
    apply();
  }
</script>

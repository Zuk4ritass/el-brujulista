---
import { getCollection } from 'astro:content';
import { u } from '../../lib/url';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuidePoster from '../../components/GuidePoster.astro';
import GuideFilters from '../../components/GuideFilters.astro';
import SearchBox from '../../components/SearchBox.astro';
import { sortGuides, type Category } from '../../lib/guides';

const guias = sortGuides(await getCollection('guias'));
// Solo ofrecemos en el filtro las categorías que tienen al menos una guía.
const categories = [...new Set(guias.map((g) => g.data.category))] as Category[];
---

<BaseLayout title="Todas las guías" description="Catálogo de guías paso a paso para Trefus, con buscador y filtros.">
  <div class="container page">
    <h1 class="page-title">Todas las guías</h1>

    <div class="tools">
      <SearchBox id="buscar-catalogo" />
      <GuideFilters categories={categories} />
    </div>
    <p class="count" id="conteo" role="status" aria-live="polite">{guias.length} guías</p>

    <ul class="poster-grid" id="lista-guias">
      {guias.map((g, i) => <GuidePoster guia={g} eager={i < 6} />)}
    </ul>
    <div class="empty panel" id="sin-resultados" hidden>
      <p><strong>No hay guías con esa búsqueda o filtros.</strong></p>
      <p>¿Aún no ves lo que buscas? <a href={u('/sugerir/')}>Pídenos esa guía</a></p>
    </div>
  </div>
</BaseLayout>

<style>
  .page-title {
    margin-bottom: 1.25rem;
  }
  .tools {
    display: grid;
    gap: 0.25rem;
  }
  .count {
    margin: 0.75rem 0 1rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ink-soft);
  }
  .poster-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(155px, 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 720px) {
    .poster-grid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 1.5rem;
    }
  }
  .empty p {
    margin: 0 0 0.4rem;
  }
</style>

<script>
  import { LEVEL_RANGES } from '../../lib/guides';
  import { initSearch } from '../../lib/search-ui';

  const form = document.querySelector<HTMLFormElement>('#filtros')!;
  const nivel = document.querySelector<HTMLSelectElement>('#f-nivel')!;
  const categoria = document.querySelector<HTMLSelectElement>('#f-categoria')!;
  const conteo = document.querySelector<HTMLElement>('#conteo')!;
  const vacio = document.querySelector<HTMLElement>('#sin-resultados')!;
  const grid = document.querySelector<HTMLElement>('#lista-guias')!;
  const posters = [...grid.querySelectorAll<HTMLElement>('[data-poster]')];
  const originalOrder = posters.slice();
  form.hidden = false;

  let matches: string[] | null = null;
  let query = '';

  const apply = () => {
    const range = LEVEL_RANGES.find((r) => r.value === nivel.value);
    const cat = categoria.value;
    // Con búsqueda: orden por relevancia. Sin búsqueda: orden original.
    const ordered = matches
      ? matches.map((s) => posters.find((p) => p.dataset.slug === s)!).filter(Boolean)
      : originalOrder;
    const inSearch = new Set(ordered);
    let visible = 0;

    for (const p of posters) {
      const min = p.dataset.levelMin ? Number(p.dataset.levelMin) : null;
      const max = p.dataset.levelMax ? Number(p.dataset.levelMax) : null;
      // Guías sin nivel conocido aparecen en cualquier rango (no las escondemos por falta de datos).
      const lvlOk = !range || ((min ?? 1) <= range.max && (max ?? 200) >= range.min);
      const catOk = !cat || p.dataset.category === cat;
      const show = inSearch.has(p) && lvlOk && catOk;
      p.hidden = !show;
      if (show) visible++;
    }
    for (const p of ordered) grid.append(p);

    conteo.textContent = query
      ? `${visible} ${visible === 1 ? 'resultado' : 'resultados'} para "${query}"`
      : visible === posters.length
        ? `${posters.length} guías`
        : `Mostrando ${visible} de ${posters.length} guías`;
    vacio.hidden = visible > 0;

    // La URL refleja búsqueda y filtros, para poder compartir el enlace.
    const next = new URLSearchParams();
    if (query) next.set('q', query);
    if (nivel.value) next.set('nivel', nivel.value);
    if (cat) next.set('categoria', cat);
    const qs = next.toString();
    history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
  };

  const ui = initSearch((slugs, q) => {
    matches = slugs;
    query = q;
    apply();
  });

  // Restaurar desde la URL (?q=goloson&nivel=51-100&categoria=quest)
  const params = new URLSearchParams(location.search);
  const setIfValid = (sel: HTMLSelectElement, v: string | null) => {
    if (v && [...sel.options].some((o) => o.value === v)) sel.value = v;
  };
  setIfValid(nivel, params.get('nivel'));
  setIfValid(categoria, params.get('categoria'));
  form.addEventListener('change', apply);
  // `reset` se dispara antes de que los selects vuelvan a su valor inicial.
  form.addEventListener('reset', () => setTimeout(() => ui?.setQuery('')));
  form.addEventListener('submit', (e) => e.preventDefault());

  if (ui) {
    ui.setQuery(params.get('q') ?? '');
    // Desde la lupa del header: /guias/?buscar → foco en el buscador
    if (params.has('buscar')) ui.input.focus();
  } else {
    apply();
  }
</script>

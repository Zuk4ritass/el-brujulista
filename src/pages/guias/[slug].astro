---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';
import StepChecklist from '../../components/StepChecklist.astro';
import KnownBugs from '../../components/KnownBugs.astro';
import GameText from '../../components/GameText.astro';
import { CATEGORY_LABELS, levelLabel } from '../../lib/guides';

export async function getStaticPaths() {
  const guias = await getCollection('guias');
  return guias.map((guia) => ({ params: { slug: guia.data.slug }, props: { guia } }));
}

const { guia } = Astro.props as { guia: CollectionEntry<'guias'> };
const { data } = guia;
const { Content } = await render(guia);
const hasBody = (guia.body ?? '').trim().length > 0;
---

<BaseLayout title={data.title} description={data.summary}>
  <div class="container page guide">
  <p class="back"><a href="/guias/">← Volver a las guías</a></p>

  <header class="guide-head">
    {
      data.example && (
        <p class="example-banner" role="note">
          <strong>Guía de ejemplo.</strong> No es contenido real de Trefus: solo sirve para probar el sitio.
        </p>
      )
    }
    <h1 class="page-title">{data.title}</h1>
    <p class="summary"><GameText text={data.summary} /></p>
    <div class="meta">
      <VerificationBadge {...data.verification} detailed />
      <span class="chip">{CATEGORY_LABELS[data.category]}</span>
      <span class="chip"><GameText text={levelLabel(data)} /></span>
    </div>
    {
      data.verification.status !== 'verificado' && (
        <p class="unverified-note">
          {data.verification.status === 'desactualizado'
            ? 'Esta guía puede estar desactualizada: algo cambió en el servidor desde que se verificó.'
            : 'Esta guía todavía no se ha comprobado jugando en Trefus. Tómala con cuidado.'}
        </p>
      )
    }
  </header>

  <StepChecklist slug={data.slug} steps={data.steps}>
  <section class="panel" aria-labelledby="req-titulo">
    <h2 id="req-titulo">Requisitos</h2>
    {
      data.requirements.length === 0 ? (
        <p>Sin requisitos especiales.</p>
      ) : (
        <ul>
          {data.requirements.map((r) => (
            <li>
              <GameText text={r} />
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {
    hasBody && (
      <section class="panel prose" aria-labelledby="ctx-titulo">
        <h2 id="ctx-titulo">Contexto</h2>
        <Content />
      </section>
    )
  }
  </StepChecklist>

  <KnownBugs bugs={data.knownBugs} />
  </div>
</BaseLayout>

<style>
  .back {
    margin: 0 0 0.5rem;
  }
  .guide {
    max-width: 820px;
  }
  .panel h2 {
    margin-top: 0;
  }
  .panel ul {
    margin: 0;
    padding-left: 1.2rem;
  }
  .summary {
    margin: 0 0 0.75rem;
    font-size: 1.1rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }
  .example-banner {
    margin: 0 0 0.75rem;
    padding: 0.6rem 0.9rem;
    border-radius: 8px;
    background: #3b3f8f;
    color: #eef0ff;
    border: 2px solid #23265e;
  }
  .unverified-note {
    margin: 0.75rem 0 0;
    font-size: 0.95rem;
    color: var(--warn);
  }
  section {
    margin-top: 1.75rem;
  }
  .guide-head {
    margin-bottom: 1rem;
  }
</style>

---
// Página de guía, versión directa: título, progreso, lo que necesitas y los pasos.
// El contexto extra queda plegado; los bugs, compactos al final.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { u } from '../../lib/url';
import BaseLayout from '../../layouts/BaseLayout.astro';
import VerificationBadge from '../../components/VerificationBadge.astro';
import StepChecklist from '../../components/StepChecklist.astro';
import KnownBugs from '../../components/KnownBugs.astro';
import GameText from '../../components/GameText.astro';
import { CATEGORY_LABELS, levelLabel } from '../../lib/guides';
import { SITE } from '../../config';

export async function getStaticPaths() {
  const guias = await getCollection('guias');
  return guias.map((guia) => ({ params: { slug: guia.data.slug }, props: { guia } }));
}

const { guia } = Astro.props as { guia: CollectionEntry<'guias'> };
const { data } = guia;
const { Content } = await render(guia);
const hasBody = (guia.body ?? '').trim().length > 0;
const level = levelLabel(data);
const description = data.summary.includes('POR COMPLETAR') ? `Guía paso a paso: ${data.title}` : data.summary;
---

<BaseLayout title={data.title} description={description}>
  <div class="container page guide">
    <a class="back" href={u('/guias/')}>← Guías</a>

    {
      data.example && (
        <p class="example-banner" role="note">
          <strong>Ejemplo:</strong> no es contenido real de Trefus.
        </p>
      )
    }

    <header class="guide-head">
      <h1 class="guide-title">{data.title}</h1>
      <div class="meta">
        <VerificationBadge {...data.verification} detailed />
        <span class="chip">{CATEGORY_LABELS[data.category]}</span>
        {!level.includes('POR COMPLETAR') && <span class="chip">{level}</span>}
      </div>
    </header>

    <StepChecklist slug={data.slug} steps={data.steps}>
      {
        data.requirements.length > 0 && (
          <div class="needs">
            <span class="needs__label">Necesitas:</span>
            <ul>
              {data.requirements.map((r) => (
                <li class="chip">
                  <GameText text={r} />
                </li>
              ))}
            </ul>
          </div>
        )
      }
      {
        hasBody && (
          <details class="more">
            <summary>Más contexto</summary>
            <div class="more__body">
              <Content />
            </div>
          </details>
        )
      }
    </StepChecklist>

    {
      data.video && (
        <section class="video" aria-labelledby="video-titulo">
          <h2 id="video-titulo" class="video__titulo">¿Prefieres verlo en video?</h2>
          <div class="video__marco">
            <iframe
              src={`https://www.youtube-nocookie.com/embed/${data.video.youtube}`}
              title={data.video.titulo}
              loading="lazy"
              allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              referrerpolicy="strict-origin-when-cross-origin"
              allowfullscreen
            ></iframe>
          </div>
          <p class="video__credito">
            <a href={`https://www.youtube.com/watch?v=${data.video.youtube}`} target="_blank" rel="noopener">«{data.video.titulo}»</a>, de <strong>{data.video.autor}</strong>. Puede no coincidir del todo con Trefus.
          </p>
        </section>
      )
    }

    {
      SITE.discordUrl && (
        <aside class="ayuda" aria-labelledby="ayuda-titulo">
          <div>
            <h2 id="ayuda-titulo" class="ayuda__titulo">¿Falta un dato o algo no te funcionó?</h2>
            <p>
              Cuéntalo en el Discord: en <strong>#aportar-datos</strong> si sabes algo que falta (nivel, recompensas,
              capturas) o en <strong>#errores-en-guias</strong> si un paso no coincide con Trefus.
            </p>
          </div>
          <a class="btn" href={SITE.discordUrl} target="_blank" rel="noopener noreferrer">
            Ir al Discord <span aria-hidden="true">↗</span>
            <span class="visually-hidden">(se abre en una pestaña nueva)</span>
          </a>
        </aside>
      )
    }

    <KnownBugs bugs={data.knownBugs} />
  </div>
</BaseLayout>

<style>
  .guide {
    max-width: 1000px;
  }
  .back {
    display: inline-block;
    margin-bottom: 0.75rem;
    color: var(--ink);
    text-decoration: none;
  }
  .back:hover {
    text-decoration: underline;
  }
  .example-banner {
    margin: 0 0 0.75rem;
    padding: 0.45rem 0.8rem;
    border: var(--line);
    border-radius: 10px;
    background: var(--blue);
    color: #fff;
    font-size: 0.95rem;
    font-weight: 700;
    box-shadow: 2px 2px 0 var(--shadow);
  }
  .guide-head {
    margin-bottom: 0.75rem;
  }
  .guide-title {
    margin: 0 0 0.6rem;
    font-size: clamp(2.2rem, 8vw, 3.4rem);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .needs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    margin: 1rem 0 0;
  }
  .needs__label {
    font: 400 1.05rem/1 var(--font-display);
  }
  .needs ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .more {
    margin-top: 0.9rem;
    border: 2px dashed var(--rule);
    border-radius: 10px;
  }
  .more summary {
    padding: 0.6rem 0.9rem;
    font-weight: 800;
    cursor: pointer;
  }
  .more__body {
    padding: 0 0.9rem 0.8rem;
  }
  .video {
    margin-top: 2rem;
  }
  .video__titulo {
    margin: 0 0 0.7rem;
    font-size: 1.5rem;
  }
  .video__marco {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: var(--line);
    border-radius: 12px;
    background: #000;
    box-shadow: 4px 4px 0 var(--shadow);
  }
  .video__marco iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video__credito {
    margin: 0.6rem 0 0;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
  .video__credito a {
    color: var(--ink);
  }
  .ayuda {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.25rem;
    margin-top: 2rem;
    padding: 1rem 1.2rem;
    border: var(--line);
    border-radius: 12px;
    background: var(--soft-yellow);
    box-shadow: 3px 3px 0 var(--shadow);
  }
  .ayuda > div {
    flex: 1 1 320px;
  }
  .ayuda__titulo {
    margin: 0 0 0.35rem;
    font-size: 1.3rem;
  }
  .ayuda p {
    margin: 0;
  }
  .more__body :global(p) {
    margin: 0 0 0.5rem;
  }
</style>

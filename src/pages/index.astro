---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroScene from '../components/HeroScene.astro';
import GuidePoster from '../components/GuidePoster.astro';
import PosterRow from '../components/PosterRow.astro';
import SearchBox from '../components/SearchBox.astro';
import VerificationBadge from '../components/VerificationBadge.astro';
import { CATEGORY_LABELS, levelLabel, sortGuides, type Category } from '../lib/guides';
import { stepId } from '../lib/slugify';

const guias = sortGuides(await getCollection('guias'));
const featured = guias.find((g) => g.data.featured) ?? guias.find((g) => !g.data.example) ?? guias[0];
const f = featured.data;
const hasLevel = !levelLabel(f).includes('POR COMPLETAR');
const hasSummary = !f.summary.includes('POR COMPLETAR');

const ROW_TITLES: Record<Category, string> = {
  quest: 'Quests',
  dungeon: 'Dungeons',
  ruta: 'Rutas y viajes',
  tip: 'Tips',
};
const byCategory = (Object.keys(ROW_TITLES) as Category[])
  .map((c) => ({ c, items: guias.filter((g) => g.data.category === c) }))
  .filter((r) => r.items.length > 0);
---

<BaseLayout title="Inicio">
  <!-- Guía destacada, en grande -->
  <section class="billboard" aria-labelledby="destacada-titulo">
    <HeroScene />
    <div class="billboard__scrim" aria-hidden="true"></div>
    <div class="container billboard__content">
      <p class="ribbon billboard__eyebrow">Guía destacada</p>
      <h1 id="destacada-titulo" class="billboard__title">{f.title}</h1>
      <div class="billboard__meta">
        <VerificationBadge status={f.verification.status} />
        <span class="chip">{CATEGORY_LABELS[f.category]}</span>
        {hasLevel && <span class="chip">{levelLabel(f)}</span>}
        <span class="chip">{f.steps.length} pasos</span>
      </div>
      {hasSummary && <p class="billboard__summary">{f.summary}</p>}
      <div class="billboard__actions">
        <a
          class="btn"
          href={`/guias/${f.slug}/`}
          data-featured-cta
          data-slug={f.slug}
          data-step-ids={f.steps.map(stepId).join(',')}
        >
          <span aria-hidden="true">▶</span> <span data-cta-label>Empezar guía</span>
        </a>
        <a class="btn btn--ghost" href="/guias/">Ver todas</a>
      </div>
    </div>
  </section>

  <div class="container">
    <div class="search-wrap">
      <SearchBox id="buscar-inicio" size="big" />
      <p class="search-note">
        Guías no oficiales para el servidor <strong>Trefus</strong>. El contenido puede diferir de Dofus 2.x.
      </p>
    </div>

    <!-- Resultados de búsqueda (reemplazan las filas mientras hay texto en el buscador) -->
    <section class="results" aria-labelledby="resultados-titulo" data-results hidden>
      <h2 id="resultados-titulo" class="results__title" data-results-title aria-live="polite">Resultados</h2>
      <ul class="poster-grid" data-results-grid>
        {guias.map((g) => <GuidePoster guia={g} />)}
      </ul>
      <div class="results__empty panel" data-results-empty hidden>
        <p><strong>No encontramos guías para "<span data-results-query></span>".</strong></p>
        <p>¿Te gustaría que exista? <a href="/sugerir/">Sugiere esta guía</a> y la tendremos en cuenta.</p>
      </div>
    </section>

    <div data-rows>
      <PosterRow title="Continúa donde quedaste" id="fila-continuar" hidden>
        {guias.map((g) => <GuidePoster guia={g} size="row" />)}
      </PosterRow>

      {
        byCategory.map(({ c, items }, i) => (
          <PosterRow title={ROW_TITLES[c]} id={`fila-${c}`}>
            {items.map((g) => (
              <GuidePoster guia={g} size="row" eager={i === 0} />
            ))}
          </PosterRow>
        ))
      }

      <p class="legend">
        <span><b class="dot dot--ok">✓</b> Verificada jugando</span>
        <span><b class="dot dot--warn">?</b> Sin verificar</span>
        <span><b class="dot dot--bad">!</b> Desactualizada</span>
        <span><span class="bar" aria-hidden="true"></span> Tu progreso</span>
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  /* ---------- Destacada ---------- */
  .billboard {
    position: relative;
    display: grid;
    align-items: end;
    min-height: clamp(460px, 72vh, 640px);
    margin-top: -3px;
    overflow: hidden;
    isolation: isolate;
  }
  .billboard__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(90deg, rgb(10 8 20 / 0.75) 0%, rgb(10 8 20 / 0.35) 50%, transparent 75%),
      linear-gradient(0deg, var(--bg) 0%, transparent 35%);
    pointer-events: none;
  }
  .billboard__content {
    position: relative;
    z-index: 2;
    padding-block: 3rem 4.5rem;
  }
  .billboard__eyebrow {
    font-size: 0.85rem;
    animation: unfurl 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    transform-origin: left center;
  }
  @keyframes unfurl {
    from {
      transform: scaleX(0);
      opacity: 0;
    }
  }
  .billboard__title {
    max-width: 14ch;
    margin: 0.8rem 0 0.9rem;
    font-size: clamp(3rem, 12vw, 6.5rem);
    line-height: 0.92;
    color: #fff8ec;
    text-shadow: 0 5px 0 rgb(0 0 0 / 0.45), 0 12px 30px rgb(0 0 0 / 0.55);
    animation: rise-in 0.8s 0.15s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .billboard__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    animation: rise-in 0.7s 0.35s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .billboard__meta .chip {
    background: rgb(0 0 0 / 0.5);
  }
  .billboard__summary {
    max-width: 46ch;
    margin: 1rem 0 0;
    font-size: 1.1rem;
    text-shadow: 0 2px 8px rgb(0 0 0 / 0.8);
  }
  .billboard__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.5rem;
    animation: rise-in 0.7s 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(0.6em);
    }
  }

  /* ---------- Buscador ---------- */
  .search-wrap {
    position: relative;
    z-index: 3;
    max-width: 720px;
    margin: -1.75rem auto 0;
  }
  .search-note {
    margin: 0.7rem 0 0;
    text-align: center;
    font-size: 0.88rem;
    color: var(--text-soft);
  }

  /* ---------- Resultados ---------- */
  .results {
    margin-top: 2rem;
  }
  .results__title {
    margin: 0 0 1rem;
    font-size: 1.3rem;
    text-transform: uppercase;
  }
  .results__empty p {
    margin: 0 0 0.4rem;
  }
  .poster-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 720px) {
    .poster-grid {
      grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    }
  }

  /* ---------- Leyenda ---------- */
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 1.5rem 0 0;
    font-size: 0.85rem;
    color: var(--text-soft);
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .dot {
    display: inline-grid;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 50%;
    font-size: 0.75rem;
  }
  .dot--ok {
    background: #1f6b3a;
    border: 2px solid #f2fff5;
    color: #fff;
  }
  .dot--warn {
    color: var(--warn);
    border: 2px dashed var(--warn);
  }
  .dot--bad {
    background: #5c1a1a;
    color: #ffe3e0;
    border: 2px solid var(--danger);
  }
  .bar {
    display: inline-block;
    width: 1.6rem;
    height: 5px;
    background: linear-gradient(90deg, var(--green) 60%, rgb(255 255 255 / 0.25) 60%);
  }
</style>

<script>
  import { initSearch } from '../lib/search-ui';
  import { loadProgress } from '../lib/progress';

  // Botón de la destacada: "Continuar" si ya empezaste
  const cta = document.querySelector<HTMLAnchorElement>('[data-featured-cta]');
  if (cta) {
    const ids = (cta.dataset.stepIds ?? '').split(',');
    const saved = loadProgress(cta.dataset.slug ?? '');
    const done = ids.filter((id) => saved.has(id)).length;
    if (done > 0 && done < ids.length) cta.querySelector('[data-cta-label]')!.textContent = `Continuar (${done}/${ids.length})`;
    if (done === ids.length) cta.querySelector('[data-cta-label]')!.textContent = 'Repasar guía';
  }

  // Fila "Continúa donde quedaste": solo guías empezadas y no terminadas
  const contRow = document.querySelector<HTMLElement>('#fila-continuar');
  if (contRow) {
    let any = false;
    for (const p of contRow.querySelectorAll<HTMLElement>('[data-poster]')) {
      const ids = (p.dataset.stepIds ?? '').split(',').filter(Boolean);
      const saved = loadProgress(p.dataset.slug ?? '');
      const done = ids.filter((id) => saved.has(id)).length;
      const show = done > 0 && done < ids.length;
      p.hidden = !show;
      any ||= show;
    }
    contRow.hidden = !any;
  }

  // Búsqueda en vivo
  const results = document.querySelector<HTMLElement>('[data-results]')!;
  const grid = document.querySelector<HTMLElement>('[data-results-grid]')!;
  const rows = document.querySelector<HTMLElement>('[data-rows]')!;
  const title = document.querySelector<HTMLElement>('[data-results-title]')!;
  const empty = document.querySelector<HTMLElement>('[data-results-empty]')!;
  const posters = new Map(
    [...grid.querySelectorAll<HTMLElement>('[data-poster]')].map((p) => [p.dataset.slug!, p]),
  );

  initSearch((slugs, query) => {
    const searching = slugs !== null;
    results.hidden = !searching;
    rows.hidden = searching;
    if (!slugs) return;
    for (const p of posters.values()) p.hidden = true;
    for (const slug of slugs) {
      const p = posters.get(slug);
      if (p) {
        p.hidden = false;
        grid.append(p); // reordena por relevancia
      }
    }
    title.textContent =
      slugs.length === 0 ? 'Sin resultados' : `${slugs.length} ${slugs.length === 1 ? 'resultado' : 'resultados'} para "${query}"`;
    empty.hidden = slugs.length > 0;
    empty.querySelector('[data-results-query]')!.textContent = query;
  });
</script>

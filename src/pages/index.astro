---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GuidePoster from '../components/GuidePoster.astro';
import PosterRow from '../components/PosterRow.astro';
import SearchBox from '../components/SearchBox.astro';
import { CATEGORY_LABELS, sortGuides, type Category } from '../lib/guides';

const guias = sortGuides(await getCollection('guias'));
// Solo categorías que tienen guías, para no ofrecer filtros vacíos.
const categories = [...new Set(guias.map((g) => g.data.category))] as Category[];
---

<BaseLayout title="Inicio">
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero__text">
      <h1 id="hero-title" class="hero__title">
        Guías de <span class="marker">Trefus</span>, paso a paso
      </h1>
      <p class="hero__lead">Cortas, claras y probadas jugando. ¿Qué necesitas?</p>
      <div class="hero__search">
        <SearchBox id="buscar-inicio" size="big" suggest placeholder="Ej: goloson, Frigost, dungeon…" />
      </div>
    </div>

    <!-- Garabato propio: mapa con camino punteado -->
    <svg class="hero__doodle" viewBox="0 0 220 180" aria-hidden="true">
      <g fill="none" stroke="#2b1a0e" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 40l58-18 64 18 62-18v118l-62 18-64-18-58 18z" fill="#fffaf0"></path>
        <path d="M76 22v118M140 40v118" stroke-width="3" stroke-opacity=".35"></path>
        <path class="hero__trail" d="M40 128c22-14 38 6 58-8s22-46 56-36" stroke="#f08a3c" stroke-dasharray="8 10"></path>
        <path d="M160 70l16 16M176 70l-16 16" stroke="#e2574c" stroke-width="7"></path>
        <circle cx="40" cy="128" r="7" fill="#8cc63f"></circle>
      </g>
    </svg>
  </section>

  <div class="container">
    <PosterRow title="Continúa donde quedaste" id="fila-continuar" hidden>
      {guias.map((g) => <GuidePoster guia={g} size="row" />)}
    </PosterRow>

    <section class="all" aria-labelledby="todas-titulo">
      <div class="all__head">
        <h2 id="todas-titulo" class="all__title">Todas las guías</h2>
        <div class="tabs" role="group" aria-label="Filtrar por tipo">
          <button type="button" class="tab" data-cat="" aria-pressed="true">Todas</button>
          {
            categories.map((c) => (
              <button type="button" class:list={['tab', `tab--${c}`]} data-cat={c} aria-pressed="false">
                {CATEGORY_LABELS[c]}
              </button>
            ))
          }
        </div>
      </div>
      <ul class="grid" data-grid>
        {guias.map((g, i) => <GuidePoster guia={g} eager={i < 4} />)}
      </ul>
      <p class="all__more">
        ¿No está lo que buscas? <a href="/sugerir/">Pídenos esa guía</a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  /* ---------- Héroe ---------- */
  .hero {
    position: relative;
    z-index: 5; /* el desplegable de sugerencias debe quedar encima de las tarjetas */
    display: grid;
    align-items: center;
    gap: 1rem 2rem;
    padding-block: clamp(2rem, 7vw, 4rem) clamp(1.5rem, 5vw, 2.5rem);
  }
  @media (min-width: 820px) {
    .hero {
      grid-template-columns: 1fr 240px;
    }
  }
  .hero__title {
    margin: 0;
    font-size: clamp(2.4rem, 8vw, 4rem);
    line-height: 1.02;
  }
  .hero__lead {
    margin: 0.75rem 0 1.25rem;
    font-size: 1.2rem;
    color: var(--ink-soft);
  }
  .hero__search {
    position: relative;
    z-index: 10;
    max-width: 620px;
  }
  .hero__doodle {
    display: none;
    width: 100%;
    rotate: 6deg;
    filter: drop-shadow(5px 5px 0 #2b1a0e);
    animation: bob 4s ease-in-out infinite;
  }
  @media (min-width: 820px) {
    .hero__doodle {
      display: block;
    }
  }
  .hero__trail {
    animation: march 1.4s linear infinite;
  }
  @keyframes bob {
    50% {
      translate: 0 -8px;
      rotate: 3deg;
    }
  }
  @keyframes march {
    to {
      stroke-dashoffset: -36;
    }
  }

  /* ---------- Todas las guías ---------- */
  .all {
    margin-top: 1.5rem;
  }
  .all__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-bottom: 1.1rem;
  }
  .all__title {
    margin: 0;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tab {
    min-height: 40px;
    padding: 0.3rem 0.95rem;
    border: var(--line);
    border-radius: 999px;
    background: var(--card);
    color: var(--ink);
    font: 400 1rem/1 var(--font-display);
    cursor: pointer;
    box-shadow: 2px 2px 0 var(--ink);
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }
  .tab:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 var(--ink);
  }
  .tab[aria-pressed='true'] {
    background: var(--yellow);
    transform: translate(2px, 2px);
    box-shadow: none;
  }
  .tab--quest[aria-pressed='true'] {
    background: var(--purple);
    color: #fff;
  }
  .tab--dungeon[aria-pressed='true'] {
    background: var(--red);
    color: #fff;
  }
  .tab--ruta[aria-pressed='true'] {
    background: var(--teal);
  }
  .tab--tip[aria-pressed='true'] {
    background: var(--green);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(155px, 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 720px) {
    .grid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 1.5rem;
    }
  }
  .all__more {
    margin: 2rem 0 0;
    color: var(--ink-soft);
  }
</style>

<script>
  import { initSuggest } from '../lib/suggest-ui';
  import { loadProgress } from '../lib/progress';

  // Fila "Continúa donde quedaste": solo guías empezadas y no terminadas
  const contRow = document.querySelector<HTMLElement>('#fila-continuar');
  if (contRow) {
    let any = false;
    for (const p of contRow.querySelectorAll<HTMLElement>('[data-poster]')) {
      const ids = (p.dataset.stepIds ?? '').split(',').filter(Boolean);
      const saved = loadProgress(p.dataset.slug ?? '');
      const done = ids.filter((id) => saved.has(id)).length;
      const show = done > 0 && done < ids.length;
      p.hidden = !show;
      any ||= show;
    }
    contRow.hidden = !any;
  }

  // Buscador: solo sugerencias en desplegable; no toca lo de abajo.
  const searchForm = document.querySelector<HTMLFormElement>('[data-search-form][data-suggest]');
  if (searchForm) initSuggest(searchForm);

  // Pestañas por tipo: filtran la cuadrícula en el sitio.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tab')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-grid] [data-poster]')];
  for (const tab of tabs) {
    tab.addEventListener('click', () => {
      const cat = tab.dataset.cat ?? '';
      for (const t of tabs) t.setAttribute('aria-pressed', String(t === tab));
      for (const c of cards) c.hidden = cat !== '' && c.dataset.category !== cat;
    });
  }
</script>

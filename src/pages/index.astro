---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroScene from '../components/HeroScene.astro';
import GuidePoster from '../components/GuidePoster.astro';
import PosterRow from '../components/PosterRow.astro';
import SearchBox from '../components/SearchBox.astro';
import { LEVEL_RANGES, sortGuides, type Category } from '../lib/guides';

const guias = sortGuides(await getCollection('guias'));
const featuredList = guias.filter((g) => g.data.featured);
const ROW_TITLES: Record<Category, string> = {
  quest: 'Quests',
  dungeon: 'Dungeons',
  ruta: 'Rutas y viajes',
  tip: 'Tips',
};
const byCategory = (Object.keys(ROW_TITLES) as Category[])
  .map((c) => ({ c, items: guias.filter((g) => g.data.category === c) }))
  .filter((r) => r.items.length > 0);
const categories = byCategory.map((r) => r.c);
const ICONS: Record<Category, string> = { quest: '📜', dungeon: '🗝️', ruta: '🧭', tip: '💡' };
---

<BaseLayout title="Inicio">
  <!-- Héroe: el buscador es lo principal -->
  <section class="hero" aria-labelledby="hero-title">
    <HeroScene />
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="container hero__content">
      <p class="ribbon hero__eyebrow">Guías de Trefus</p>
      <h1 id="hero-title" class="hero__title">¿Qué quieres hacer hoy?</h1>
      <div class="hero__search">
        <SearchBox id="buscar-inicio" size="big" />
      </div>

      <!-- Intereses: filtran al instante, solos o junto con la búsqueda -->
      <div class="interests" data-interests>
        <div class="interests__group" role="group" aria-label="Tipo de guía">
          {
            categories.map((c) => (
              <button type="button" class="interest" data-filter="cat" data-value={c} aria-pressed="false">
                <span aria-hidden="true">{ICONS[c]}</span> {ROW_TITLES[c]}
              </button>
            ))
          }
        </div>
        <div class="interests__group" role="group" aria-label="Rango de nivel">
          {
            LEVEL_RANGES.map((r) => (
              <button type="button" class="interest interest--level" data-filter="lvl" data-value={r.value} aria-pressed="false">
                Nv. {r.min}–{r.max}
              </button>
            ))
          }
        </div>
      </div>

      <p class="hero__note">
        Guías no oficiales para el servidor <strong>Trefus</strong>. El contenido puede diferir de Dofus 2.x.
      </p>
    </div>
  </section>

  <div class="container">
    <!-- Resultados de búsqueda (reemplazan las filas mientras hay texto en el buscador) -->
    <section class="results" aria-labelledby="resultados-titulo" data-results hidden>
      <h2 id="resultados-titulo" class="results__title" data-results-title aria-live="polite">Resultados</h2>
      <ul class="poster-grid" data-results-grid>
        {guias.map((g) => <GuidePoster guia={g} />)}
      </ul>
      <div class="results__empty panel" data-results-empty hidden>
        <p><strong>No encontramos guías con eso todavía.</strong></p>
        <p>¿Te gustaría que exista? <a href="/sugerir/">Sugiere esta guía</a> y la tendremos en cuenta.</p>
      </div>
    </section>

    <div data-rows>
      <PosterRow title="Continúa donde quedaste" id="fila-continuar" hidden>
        {guias.map((g) => <GuidePoster guia={g} size="row" />)}
      </PosterRow>

      {
        featuredList.length > 0 && (
          <PosterRow title="Destacadas" id="fila-destacadas">
            {featuredList.map((g) => (
              <GuidePoster guia={g} size="row" eager />
            ))}
          </PosterRow>
        )
      }

      {
        byCategory.map(({ c, items }, i) => (
          <PosterRow title={ROW_TITLES[c]} id={`fila-${c}`}>
            {items.map((g) => (
              <GuidePoster guia={g} size="row" eager={i === 0} />
            ))}
          </PosterRow>
        ))
      }

      <p class="legend">
        <span><b class="dot dot--ok">✓</b> Verificada jugando</span>
        <span><b class="dot dot--warn">?</b> Sin verificar</span>
        <span><b class="dot dot--bad">!</b> Desactualizada</span>
        <span><span class="bar" aria-hidden="true"></span> Tu progreso</span>
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  /* ---------- Héroe con buscador ---------- */
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: clamp(440px, 66vh, 600px);
    margin-top: -3px;
    overflow: hidden;
    isolation: isolate;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      radial-gradient(ellipse 70% 60% at 50% 45%, rgb(10 8 20 / 0.6), transparent 75%),
      linear-gradient(0deg, var(--bg) 0%, transparent 30%);
    pointer-events: none;
  }
  .hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 3rem 3.5rem;
    text-align: center;
  }
  .hero__eyebrow {
    font-size: 0.85rem;
    animation: unfurl 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  @keyframes unfurl {
    from {
      transform: scaleX(0);
      opacity: 0;
    }
  }
  .hero__title {
    margin: 0.8rem 0 1.4rem;
    font-size: clamp(2.2rem, 7vw, 4rem);
    line-height: 1;
    color: #fff8ec;
    text-shadow: 0 4px 0 rgb(0 0 0 / 0.45), 0 10px 30px rgb(0 0 0 / 0.55);
    animation: rise-in 0.8s 0.15s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .hero__search {
    width: 100%;
    max-width: 680px;
    animation: rise-in 0.7s 0.3s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .hero__note {
    max-width: 52ch;
    margin: 1.25rem 0 0;
    font-size: 0.85rem;
    color: #e6d8bd;
    text-shadow: 0 2px 6px rgb(0 0 0 / 0.8);
  }
  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(0.6em);
    }
  }

  /* ---------- Intereses ---------- */
  .interests {
    display: grid;
    gap: 0.6rem;
    justify-items: center;
    margin-top: 1.1rem;
    animation: rise-in 0.7s 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  .interests__group {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
  .interest {
    min-height: 40px;
    padding: 0.35rem 1rem;
    border: 2px solid rgb(243 230 204 / 0.35);
    border-radius: 999px;
    background: rgb(14 10 6 / 0.7);
    color: var(--text);
    font: 600 0.95rem/1 var(--font-body);
    cursor: pointer;
    backdrop-filter: blur(4px);
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
  }
  .interest:hover {
    border-color: var(--gold);
    transform: translateY(-2px);
  }
  .interest--level {
    font-size: 0.85rem;
    min-height: 34px;
    padding-inline: 0.8rem;
  }
  .interest[aria-pressed='true'] {
    background: var(--gold);
    border-color: var(--gold);
    color: #2b1d12;
    font-weight: 800;
  }

  /* ---------- Resultados ---------- */
  .results {
    margin-top: 1.5rem;
  }
  .results__title {
    margin: 0 0 1rem;
    font-size: 1.3rem;
    text-transform: uppercase;
  }
  .results__empty p {
    margin: 0 0 0.4rem;
  }
  .poster-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
  }
  @media (min-width: 720px) {
    .poster-grid {
      grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    }
  }

  /* ---------- Leyenda ---------- */
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 1.5rem 0 0;
    font-size: 0.85rem;
    color: var(--text-soft);
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .dot {
    display: inline-grid;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 50%;
    font-size: 0.75rem;
  }
  .dot--ok {
    background: #1f6b3a;
    border: 2px solid #f2fff5;
    color: #fff;
  }
  .dot--warn {
    color: var(--warn);
    border: 2px dashed var(--warn);
  }
  .dot--bad {
    background: #5c1a1a;
    color: #ffe3e0;
    border: 2px solid var(--danger);
  }
  .bar {
    display: inline-block;
    width: 1.6rem;
    height: 5px;
    background: linear-gradient(90deg, var(--green) 60%, rgb(255 255 255 / 0.25) 60%);
  }
</style>

<script>
  import { initSearch } from '../lib/search-ui';
  import { loadProgress } from '../lib/progress';
  import { CATEGORY_LABELS, LEVEL_RANGES, type Category } from '../lib/guides';

  // Fila "Continúa donde quedaste": solo guías empezadas y no terminadas
  const contRow = document.querySelector<HTMLElement>('#fila-continuar');
  if (contRow) {
    let any = false;
    for (const p of contRow.querySelectorAll<HTMLElement>('[data-poster]')) {
      const ids = (p.dataset.stepIds ?? '').split(',').filter(Boolean);
      const saved = loadProgress(p.dataset.slug ?? '');
      const done = ids.filter((id) => saved.has(id)).length;
      const show = done > 0 && done < ids.length;
      p.hidden = !show;
      any ||= show;
    }
    contRow.hidden = !any;
  }

  // Búsqueda + intereses. Si hay texto o algún interés activo, los resultados reemplazan las filas.
  const results = document.querySelector<HTMLElement>('[data-results]')!;
  const grid = document.querySelector<HTMLElement>('[data-results-grid]')!;
  const rows = document.querySelector<HTMLElement>('[data-rows]')!;
  const title = document.querySelector<HTMLElement>('[data-results-title]')!;
  const empty = document.querySelector<HTMLElement>('[data-results-empty]')!;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-interests] [data-filter]')];
  const allPosters = [...grid.querySelectorAll<HTMLElement>('[data-poster]')];
  const bySlug = new Map(allPosters.map((p) => [p.dataset.slug!, p]));

  let matches: string[] | null = null;
  let query = '';
  const active = { cat: '', lvl: '' };

  const render = () => {
    const filtering = matches !== null || active.cat !== '' || active.lvl !== '';
    results.hidden = !filtering;
    rows.hidden = filtering;
    if (!filtering) return;

    const range = LEVEL_RANGES.find((r) => r.value === active.lvl);
    const ordered = matches ? matches.map((s) => bySlug.get(s)).filter((p): p is HTMLElement => !!p) : allPosters;
    const keep = new Set(ordered);
    let visible = 0;
    for (const p of allPosters) {
      const min = p.dataset.levelMin ? Number(p.dataset.levelMin) : null;
      const max = p.dataset.levelMax ? Number(p.dataset.levelMax) : null;
      // Guías sin nivel conocido aparecen en cualquier rango (no las escondemos por falta de datos).
      const lvlOk = !range || ((min ?? 1) <= range.max && (max ?? 200) >= range.min);
      const catOk = !active.cat || p.dataset.category === active.cat;
      const show = keep.has(p) && lvlOk && catOk;
      p.hidden = !show;
      if (show) visible++;
    }
    for (const p of ordered) grid.append(p); // orden por relevancia

    const parts = [
      query && `"${query}"`,
      active.cat && CATEGORY_LABELS[active.cat as Category],
      range && `nivel ${range.min}–${range.max}`,
    ].filter(Boolean);
    title.textContent =
      visible === 0
        ? 'Sin resultados'
        : `${visible} ${visible === 1 ? 'guía' : 'guías'}: ${parts.join(' · ')}`;
    empty.hidden = visible > 0;
  };

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const key = chip.dataset.filter as 'cat' | 'lvl';
      // Un interés por grupo: tocar el activo lo quita.
      active[key] = active[key] === chip.dataset.value ? '' : chip.dataset.value!;
      for (const c of chips) {
        if (c.dataset.filter === key) c.setAttribute('aria-pressed', String(c.dataset.value === active[key]));
      }
      render();
    });
  }

  initSearch((slugs, q) => {
    matches = slugs;
    query = q;
    render();
  });
</script>
